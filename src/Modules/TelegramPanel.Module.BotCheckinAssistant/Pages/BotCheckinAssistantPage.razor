@namespace TelegramPanel.Module.BotCheckinAssistant.Pages
@inject AccountManagementService AccountManagement
@inject AccountTelegramToolsService AccountTelegramTools
@inject BotCheckinAssistantPresetStore PresetStore
@inject BotCheckinTelegramCompatService BotCompat
@inject ISnackbar Snackbar
@inject ILogger<BotCheckinAssistantPage> Logger

<PageTitle>@TextTitle</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4 tp-page-title">@TextTitle</MudText>

<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudStack Spacing="2">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            @TextIntro
        </MudAlert>

        <MudGrid>
            <MudItem xs="12" md="5">
                <MudSelect T="string"
                           Value="@selectedPresetName"
                           ValueChanged="ApplyPresetSelectionAsync"
                           Label="@TextPresetLabel"
                           Variant="Variant.Outlined"
                           Disabled="@running"
                           HelperText="@TextPresetHelper">
                    <MudSelectItem T="string" Value="@string.Empty">@TextPresetNone</MudSelectItem>
                    @foreach (var preset in presets)
                    {
                        <MudSelectItem T="string" Value="@preset.Name">@preset.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="presetName"
                              Label="@TextPresetNameLabel"
                              Variant="Variant.Outlined"
                              Disabled="@running"
                              Placeholder="@TextPresetNamePlaceholder" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudStack Row="true" Spacing="1">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Disabled="@running"
                               OnClick="SaveCurrentPresetAsync">
                        @TextSavePreset
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               Disabled="@(running || string.IsNullOrWhiteSpace(selectedPresetName))"
                               OnClick="DeleteSelectedPresetAsync">
                        @TextDeletePreset
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>

        <MudTextField @bind-Value="botTarget"
                      @bind-Value:after="OnBotTargetChangedAsync"
                      Label="@TextBotTargetLabel"
                      Variant="Variant.Outlined"
                      Placeholder="@TextBotTargetPlaceholder"
                      Disabled="@running"
                      Immediate="true" />

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="startParameter"
                              Label="@TextStartParameterLabel"
                              Variant="Variant.Outlined"
                              Placeholder="invite_abc"
                              Disabled="@running" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField T="int"
                                 @bind-Value="waitTimeoutSeconds"
                                 Label="@TextWaitReplyLabel"
                                 Variant="Variant.Outlined"
                                 Min="3"
                                 Max="300"
                                 Disabled="@running" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField T="int"
                                 @bind-Value="delayBetweenAccountsSeconds"
                                 Label="@TextDelayLabel"
                                 Variant="Variant.Outlined"
                                 Min="0"
                                 Max="600"
                                 Disabled="@running" />
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSwitch @bind-Value="autoStartBeforeFirstMessage"
                           Label="@TextAutoStart"
                           Disabled="@running" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSwitch @bind-Value="markRepliesAsRead"
                           Label="@TextMarkRead"
                           Disabled="@running" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSwitch @bind-Value="enableRandomDelay"
                           Label="@TextRandomDelay"
                           Disabled="@running" />
            </MudItem>
        </MudGrid>

        @if (enableRandomDelay)
        {
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudNumericField T="int"
                                     @bind-Value="randomDelayMinSeconds"
                                     Label="@TextRandomDelayMin"
                                     Variant="Variant.Outlined"
                                     Min="0"
                                     Max="600"
                                     Disabled="@running" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="int"
                                     @bind-Value="randomDelayMaxSeconds"
                                     Label="@TextRandomDelayMax"
                                     Variant="Variant.Outlined"
                                     Min="0"
                                     Max="600"
                                     Disabled="@running" />
                </MudItem>
            </MudGrid>
        }

        <MudSwitch @bind-Value="autoContinueAllSteps"
                   Label="@TextAutoContinue"
                   Disabled="@running" />

        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
            @ExecutionModeDescription
        </MudAlert>

        <MudTextField @bind-Value="messageScript"
                      Label="@TextScriptLabel"
                      Variant="Variant.Outlined"
                      Lines="6"
                      Immediate="true"
                      Disabled="@running"
                      HelperText="@TextScriptHelper" />

        @if (recentCommands.Count > 0)
        {
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.body2" Class="mt-1">@TextHistoryCommands</MudText>
                @foreach (var command in recentCommands)
                {
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Default"
                               Disabled="@running"
                               OnClick="@(() => AppendCommandFromHistory(command.Command))">
                        @Shorten(command.Command, 18)
                    </MudButton>
                }
            </MudStack>
        }

        <MudDivider />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">@TextAccountList</MudText>
            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@string.Format(TextSelectedCount, selectedAccountIds.Count, accounts.Count)</MudChip>
            @if (rememberedBotAccountIds.Count > 0)
            {
                <MudChip T="string" Color="Color.Info" Size="Size.Small">@string.Format(TextRememberedCount, rememberedBotAccountIds.Count)</MudChip>
            }
            <MudSpacer />
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@(running || loadingAccounts)"
                       OnClick="ReloadAccountsAsync">
                @TextRefreshAccounts
            </MudButton>
        </MudStack>

        <MudTextField @bind-Value="accountSearch"
                      Label="@TextSearchAccountLabel"
                      Placeholder="@TextSearchAccountPlaceholder"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Disabled="@running" />

        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       Disabled="@running"
                       OnClick="SelectAllFilteredAsync">
                @TextSelectFiltered
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Secondary"
                       Disabled="@running"
                       OnClick="ClearSelectionAsync">
                @TextClearSelection
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Info"
                       Disabled="@(running || string.IsNullOrWhiteSpace(botTarget))"
                       OnClick="LoadRememberedBotUsageAsync">
                @TextLoadRemembered
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Info"
                       Disabled="@(running || string.IsNullOrWhiteSpace(botTarget) || loadingBotUsage)"
                       OnClick="ScanBotUsageFromTelegramAsync">
                @TextScanHistory
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Success"
                       Disabled="@(running || rememberedBotAccountIds.Count == 0)"
                       OnClick="SelectRememberedBotAccountsAsync">
                @TextSelectRemembered
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="@(showOnlyUsedWithBot ? Color.Warning : Color.Default)"
                       Disabled="@(running || rememberedBotAccountIds.Count == 0)"
                       OnClick="ToggleUsedBotFilter">
                @(showOnlyUsedWithBot ? TextShowAllAccounts : TextOnlyBotAccounts)
            </MudButton>
        </MudStack>

        <MudTable Items="@FilteredAccounts"
                  Dense="true"
                  Hover="true"
                  Loading="@(loadingAccounts || loadingBotUsage)"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>@TextColumnChoose</MudTh>
                <MudTh>ID</MudTh>
                <MudTh>@TextColumnPhone</MudTh>
                <MudTh>@TextColumnUsername</MudTh>
                <MudTh>@TextColumnDisplay</MudTh>
                <MudTh>@TextColumnRemembered</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@TextColumnChoose">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="@(selectedAccountIds.Contains(context.Id) ? Color.Success : Color.Default)"
                               Disabled="@running"
                               OnClick="@(() => ToggleAccountSelectionAsync(context.Id))">
                        @(selectedAccountIds.Contains(context.Id) ? TextSelected : TextChoose)
                    </MudButton>
                </MudTd>
                <MudTd DataLabel="ID">@context.Id</MudTd>
                <MudTd DataLabel="@TextColumnPhone">@context.DisplayPhone</MudTd>
                <MudTd DataLabel="@TextColumnUsername">@(!string.IsNullOrWhiteSpace(context.Username) ? $"@{context.Username}" : "-")</MudTd>
                <MudTd DataLabel="@TextColumnDisplay">@DisplayName(context)</MudTd>
                <MudTd DataLabel="@TextColumnRemembered">
                    <MudChip T="string" Size="Size.Small" Color="@(rememberedBotAccountIds.Contains(context.Id) ? Color.Info : Color.Default)">
                        @(rememberedBotAccountIds.Contains(context.Id) ? TextYes : "-")
                    </MudChip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>@TextNoAccounts</MudText>
            </NoRecordsContent>
        </MudTable>

        <MudDivider />

        <MudAlert Severity="@StartHintSeverity" Variant="Variant.Outlined" Dense="true">
            @StartHintText
        </MudAlert>

        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
            @($"{TextCurrentStatusPrefix}{currentStatusText}")
        </MudAlert>

        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       Disabled="@(!CanStart)"
                       OnClick="StartWorkflowAsync">
                @(autoContinueAllSteps ? TextStartContinuous : TextStartFirst)
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.SkipNext"
                       Disabled="@(!CanContinue)"
                       OnClick="ContinueWorkflowAsync">
                @TextContinue
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Stop"
                       Disabled="@(!CanStop)"
                       OnClick="StopWorkflowAsync">
                @TextStop
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       Disabled="@(!CanReset)"
                       OnClick="ResetWorkflowAsync">
                @TextReset
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@if (previewRow != null)
{
    <MudPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            <MudText Typo="Typo.h6">@($"{TextReplyPreviewTitle}{previewRow.AccountLabel}")</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="ClosePreview">@TextClose</MudButton>
        </MudStack>
        <MudTextField Value="@previewRow.ResponseText"
                      Label="@TextReplyFullLabel"
                      Variant="Variant.Outlined"
                      Lines="12"
                      ReadOnly="true" />
        @if (!string.IsNullOrWhiteSpace(previewRow.ResponseButtonsSummary))
        {
            <MudText Typo="Typo.body2" Class="mt-2">@($"{TextReplyButtonsPrefix}{previewRow.ResponseButtonsSummary}")</MudText>
        }
    </MudPaper>
}

@if (currentStepResults.Count > 0)
{
    <MudPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            <MudText Typo="Typo.h6">@string.Format(TextCurrentViewTitle, CurrentViewStepNumber)</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Success">@string.Format(TextSendSuccessCount, currentStepResults.Count(x => x.SendSuccess))</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Info">@string.Format(TextReplyCapturedCount, currentStepResults.Count(x => x.ResponseSuccess))</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Error">@string.Format(TextIssueCount, currentStepResults.Count(x => HasRowIssue(x)))</MudChip>
            <MudSpacer />
            <MudButton Variant="Variant.Text"
                       Color="Color.Warning"
                       Disabled="@running"
                       OnClick="SelectFailedAccountsFromCurrentRoundAsync">
                @TextSelectFailedAccounts
            </MudButton>
        </MudStack>

        <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
            @($"{TextCurrentScriptPrefix}{Shorten(workflowMessages.ElementAtOrDefault(Math.Max(currentStepIndex, 0)), 200)}")
        </MudText>

        <MudTable Items="@currentStepResults"
                  Dense="true"
                  Hover="true"
                  Breakpoint="Breakpoint.Sm"
                  Class="tp-result-table">
            <ColGroup>
                <col style="width: 12%;" />
                <col style="width: 8%;" />
                <col style="width: 9%;" />
                <col style="width: 39%;" />
                <col style="width: 17%;" />
                <col style="width: 15%;" />
            </ColGroup>
            <HeaderContent>
                <MudTh>@TextResultAccount</MudTh>
                <MudTh>@TextResultSend</MudTh>
                <MudTh>@TextResultReply</MudTh>
                <MudTh>@TextResultReplyContent</MudTh>
                <MudTh>@TextResultReplyButtons</MudTh>
                <MudTh>@TextResultError</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@TextResultAccount">@context.AccountLabel</MudTd>
                <MudTd DataLabel="@TextResultSend">
                    <MudChip T="string" Size="Size.Small" Color="@(context.SendSuccess ? Color.Success : Color.Error)">
                        @(context.SendSuccess ? TextSuccess : TextFailure)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="@TextResultReply">
                    <MudChip T="string" Size="Size.Small" Color="@(context.ResponseSuccess ? Color.Success : Color.Default)">
                        @(context.ResponseSuccess ? (context.MarkedAsRead ? TextReplyRead : TextReplyCaptured) : TextReplyNone)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="@TextResultReplyContent" Class="tp-wrap-cell">
                    <MudText Typo="Typo.body2">@ShortenMultiline(context.ResponseText, 220)</MudText>
                    @if (!string.IsNullOrWhiteSpace(context.ResponseText) && context.ResponseText.Length > 220)
                    {
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="@(() => ShowReplyPreview(context))">
                            @TextViewFull
                        </MudButton>
                    }
                </MudTd>
                <MudTd DataLabel="@TextResultReplyButtons" Class="tp-wrap-cell">
                    @if (!string.IsNullOrWhiteSpace(context.ResponseButtonsSummary))
                    {
                        <MudText Typo="Typo.caption" Class="mb-1">@context.ResponseButtonsSummary</MudText>
                    }
                    @if (context.ResponseButtons.Count == 0)
                    {
                        <MudText Typo="Typo.body2">-</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="1">
                            @foreach (var button in context.ResponseButtons)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           Disabled="@(running || activeResponseButtonKey == $"{context.AccountId}:{button.Index}")"
                                           OnClick="@(() => ClickResponseButtonAsync(context.AccountId, button.Index))">
                                    @Shorten(button.Text, 20)
                                </MudButton>
                            }
                        </MudStack>
                    }
                </MudTd>
                <MudTd DataLabel="@TextResultError" Class="tp-wrap-cell">
                    @ShortenMultiline(context.Error, 120)
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@if (history.Count > 0)
{
    <MudPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">@TextHistoryTitle</MudText>
        <MudTable Items="@history" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>@TextHistoryTime</MudTh>
                <MudTh>@TextHistoryStep</MudTh>
                <MudTh>@TextHistoryMessage</MudTh>
                <MudTh>@TextHistorySend</MudTh>
                <MudTh>@TextHistoryReply</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@TextHistoryTime">@context.ExecutedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                <MudTd DataLabel="@TextHistoryStep">@context.StepNumber</MudTd>
                <MudTd DataLabel="@TextHistoryMessage">@Shorten(context.Message, 80)</MudTd>
                <MudTd DataLabel="@TextHistorySend">@($"{context.Results.Count(x => x.SendSuccess)}/{context.Results.Count}")</MudTd>
                <MudTd DataLabel="@TextHistoryReply">@($"{context.Results.Count(x => x.ResponseSuccess)}/{context.Results.Count}")</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

<style>
    .tp-result-table .mud-table-container table {
        table-layout: fixed;
        width: 100%;
    }

    .tp-wrap-cell {
        white-space: normal;
        word-break: break-word;
        vertical-align: top;
    }
</style>

