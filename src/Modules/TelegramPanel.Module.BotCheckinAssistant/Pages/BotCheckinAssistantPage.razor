@namespace TelegramPanel.Module.BotCheckinAssistant.Pages
@inject AccountManagementService AccountManagement
@inject AccountTelegramToolsService AccountTelegramTools
@inject BotCheckinAssistantPresetStore PresetStore
@inject BotCheckinTelegramCompatService BotCompat
@inject ISnackbar Snackbar
@inject ILogger<BotCheckinAssistantPage> Logger

<PageTitle>机器人签到助手</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4 tp-page-title">机器人签到助手</MudText>

<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudStack Spacing="2">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            适合批量给签到机器人发消息、查看回复、点回复按钮，并在看完结果后决定继续下一条还是停止。
        </MudAlert>

        <MudGrid>
            <MudItem xs="12" md="5">
                <MudSelect T="string"
                           Value="@selectedPresetName"
                           ValueChanged="ApplyPresetSelectionAsync"
                           Label="常用记录"
                           Variant="Variant.Outlined"
                           Disabled="@running"
                           HelperText="可保存整套机器人、脚本和账号选择">
                    <MudSelectItem T="string" Value="@string.Empty">不使用记录</MudSelectItem>
                    @foreach (var preset in presets)
                    {
                        <MudSelectItem T="string" Value="@preset.Name">@preset.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="presetName"
                              Label="记录名称"
                              Variant="Variant.Outlined"
                              Disabled="@running"
                              Placeholder="例如：某机器人每日签到" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudStack Row="true" Spacing="1">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Disabled="@running"
                               OnClick="SaveCurrentPresetAsync">
                        保存记录
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               Disabled="@(running || string.IsNullOrWhiteSpace(selectedPresetName))"
                               OnClick="DeleteSelectedPresetAsync">
                        删除记录
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>

        <MudTextField @bind-Value="botTarget"
                      @bind-Value:after="OnBotTargetChangedAsync"
                      Label="机器人用户名或链接"
                      Variant="Variant.Outlined"
                      Placeholder="@BotTargetPlaceholder"
                      Disabled="@running"
                      Immediate="true" />

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="startParameter"
                              Label="/start 参数（可选）"
                              Variant="Variant.Outlined"
                              Placeholder="invite_abc"
                              Disabled="@running" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField T="int" @bind-Value="waitTimeoutSeconds"
                                 Label="等待回复超时（秒）"
                                 Variant="Variant.Outlined"
                                 Min="3"
                                 Max="300"
                                 Disabled="@running" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField T="int" @bind-Value="delayBetweenAccountsSeconds"
                                 Label="账号间隔（秒）"
                                 Variant="Variant.Outlined"
                                 Min="0"
                                 Max="60"
                                 Disabled="@running" />
            </MudItem>
        </MudGrid>

        <MudSwitch @bind-Value="autoStartBeforeFirstMessage"
                   Label="首条脚本前先发送 /start"
                   Disabled="@running" />

        <MudTextField @bind-Value="messageScript"
                      Label="消息脚本（每行一条）"
                      Variant="Variant.Outlined"
                      Lines="6"
                      Immediate="true"
                      Disabled="@running"
                      HelperText="不再内置默认命令。下方会显示你用过的历史命令候选，点一下可插入。" />

        @if (recentCommands.Count > 0)
        {
            <MudStack Row="true" Spacing="1">
                <MudText Typo="Typo.body2" Class="mt-1">历史命令候选：</MudText>
                @foreach (var command in recentCommands)
                {
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Default"
                               Disabled="@running"
                               OnClick="@(() => AppendCommandFromHistory(command.Command))">
                        @Shorten(command.Command, 16)
                    </MudButton>
                }
            </MudStack>
        }

        <MudDivider />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">账号列表</MudText>
            <MudChip T="string" Color="Color.Primary" Size="Size.Small">已选择 @selectedAccountIds.Count / @accounts.Count</MudChip>
            @if (rememberedBotAccountIds.Count > 0)
            {
                <MudChip T="string" Color="Color.Info" Size="Size.Small">已识别该机器人常用账号 @rememberedBotAccountIds.Count</MudChip>
            }
            <MudSpacer />
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@(running || loadingAccounts)"
                       OnClick="ReloadAccountsAsync">
                刷新账号
            </MudButton>
        </MudStack>

        <MudTextField @bind-Value="accountSearch"
                      Label="搜索账号"
                      Placeholder="手机号 / 用户名 / 昵称 / 备注"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Disabled="@running" />

        <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       Disabled="@running"
                       OnClick="SelectAllFiltered">
                选择当前筛选
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Secondary"
                       Disabled="@running"
                       OnClick="ClearSelection">
                清空选择
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Info"
                       Disabled="@(running || string.IsNullOrWhiteSpace(botTarget))"
                       OnClick="LoadRememberedBotUsageAsync">
                读取本地常用账号
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Info"
                       Disabled="@(running || string.IsNullOrWhiteSpace(botTarget) || loadingBotUsage)"
                       OnClick="ScanBotUsageFromTelegramAsync">
                扫描真实历史
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Success"
                       Disabled="@(running || rememberedBotAccountIds.Count == 0)"
                       OnClick="SelectRememberedBotAccounts">
                一键选择该机器人常用账号
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="@(showOnlyUsedWithBot ? Color.Warning : Color.Default)"
                       Disabled="@(running || rememberedBotAccountIds.Count == 0)"
                       OnClick="ToggleUsedBotFilter">
                @(showOnlyUsedWithBot ? "显示全部账号" : "仅看该机器人常用账号")
            </MudButton>
        </MudStack>

        <MudTable Items="FilteredAccounts"
                  Dense="true"
                  Hover="true"
                  Loading="@(loadingAccounts || loadingBotUsage)"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>选择</MudTh>
                <MudTh>ID</MudTh>
                <MudTh>手机号</MudTh>
                <MudTh>用户名</MudTh>
                <MudTh>昵称 / 备注</MudTh>
                <MudTh>该机器人常用</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="选择">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="@(selectedAccountIds.Contains(context.Id) ? Color.Success : Color.Default)"
                               Disabled="@running"
                               OnClick="@(() => ToggleAccountSelectionAsync(context.Id))">
                        @(selectedAccountIds.Contains(context.Id) ? "已选中" : "选择")
                    </MudButton>
                </MudTd>
                <MudTd DataLabel="ID">@context.Id</MudTd>
                <MudTd DataLabel="手机号">@context.DisplayPhone</MudTd>
                <MudTd DataLabel="用户名">@(!string.IsNullOrWhiteSpace(context.Username) ? $"@{context.Username}" : "-")</MudTd>
                <MudTd DataLabel="昵称 / 备注">@DisplayName(context)</MudTd>
                <MudTd DataLabel="该机器人常用">
                    <MudChip T="string" Size="Size.Small" Color="@(rememberedBotAccountIds.Contains(context.Id) ? Color.Info : Color.Default)">
                        @(rememberedBotAccountIds.Contains(context.Id) ? "是" : "-")
                    </MudChip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>没有匹配到账号。</MudText>
            </NoRecordsContent>
        </MudTable>

        <MudDivider />

        <MudAlert Severity="@StartHintSeverity" Variant="Variant.Outlined" Dense="true">
            @StartHintText
        </MudAlert>

        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
            当前状态：@currentStatusText
        </MudAlert>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       Disabled="@(!CanStart)"
                       OnClick="StartWorkflowAsync">
                开始第 1 条
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.SkipNext"
                       Disabled="@(!CanContinue)"
                       OnClick="ContinueWorkflowAsync">
                继续下一条
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Stop"
                       Disabled="@(!CanStop)"
                       OnClick="StopWorkflow">
                停止
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       Disabled="@(!CanReset)"
                       OnClick="ResetWorkflow">
                重置
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@if (currentStepResults.Count > 0)
{
    <MudPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            <MudText Typo="Typo.h6">当前轮次：第 @(Math.Max(currentStepIndex + 1, 1)) 条</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Success">发送成功 @currentStepResults.Count(x => x.SendSuccess)</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Info">已捕获回复 @currentStepResults.Count(x => x.ResponseSuccess)</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Error">异常或未回复 @currentStepResults.Count(x => !string.IsNullOrWhiteSpace(x.Error))</MudChip>
            <MudSpacer />
            <MudButton Variant="Variant.Text"
                       Color="Color.Warning"
                       Disabled="@running"
                       OnClick="SelectFailedAccountsFromCurrentRound">
                选中失败账号
            </MudButton>
        </MudStack>

        <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
            发送内容：@Shorten(workflowMessages.ElementAtOrDefault(Math.Max(currentStepIndex, 0)), 200)
        </MudText>

        <MudTable Items="currentStepResults" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>账号</MudTh>
                <MudTh>发送</MudTh>
                <MudTh>回复</MudTh>
                <MudTh>回复内容</MudTh>
                <MudTh>回复按钮</MudTh>
                <MudTh>错误</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="账号">@context.AccountLabel</MudTd>
                <MudTd DataLabel="发送">
                    <MudChip T="string" Size="Size.Small" Color="@(context.SendSuccess ? Color.Success : Color.Error)">
                        @(context.SendSuccess ? "成功" : "失败")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="回复">
                    <MudChip T="string" Size="Size.Small" Color="@(context.ResponseSuccess ? Color.Success : Color.Default)">
                        @(context.ResponseSuccess ? "已捕获并已读" : "无")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="回复内容">@ToSingleLine(context.ResponseText, 120)</MudTd>
                <MudTd DataLabel="回复按钮">
                    @if (context.ResponseButtons.Count == 0)
                    {
                        <MudText Typo="Typo.body2">-</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="1">
                            @foreach (var button in context.ResponseButtons)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           Disabled="@(running || activeResponseButtonKey == $"{context.AccountId}:{button.Index}")"
                                           OnClick="@(() => ClickResponseButtonAsync(context.AccountId, button.Index))">
                                    @Shorten(button.Text, 20)
                                </MudButton>
                            }
                        </MudStack>
                    }
                </MudTd>
                <MudTd DataLabel="错误">@ToSingleLine(context.Error, 120)</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@if (history.Count > 0)
{
    <MudPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">执行历史</MudText>
        <MudTable Items="history" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>时间</MudTh>
                <MudTh>脚本行</MudTh>
                <MudTh>消息</MudTh>
                <MudTh>发送成功</MudTh>
                <MudTh>捕获回复</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="时间">@context.ExecutedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                <MudTd DataLabel="脚本行">@context.StepNumber</MudTd>
                <MudTd DataLabel="消息">@Shorten(context.Message, 80)</MudTd>
                <MudTd DataLabel="发送成功">@($"{context.Results.Count(x => x.SendSuccess)}/{context.Results.Count}")</MudTd>
                <MudTd DataLabel="捕获回复">@($"{context.Results.Count(x => x.ResponseSuccess)}/{context.Results.Count}")</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    [Parameter] public string ModuleId { get; set; } = "";
    [Parameter] public string PageKey { get; set; } = "";

    private const string BotTargetPlaceholder = "examplebot 或 https://t.me/examplebot";

    private bool loadingAccounts = true;
    private bool loadingBotUsage;
    private bool running;
    private bool workflowActive;
    private int currentStepIndex = -1;

    private string botTarget = string.Empty;
    private string startParameter = string.Empty;
    private bool autoStartBeforeFirstMessage = true;
    private int waitTimeoutSeconds = 25;
    private int delayBetweenAccountsSeconds = 2;
    private string messageScript = string.Empty;
    private string accountSearch = string.Empty;
    private string currentStatusText = "等待开始";
    private string selectedPresetName = string.Empty;
    private string presetName = string.Empty;
    private string activeResponseButtonKey = string.Empty;

    private bool showOnlyUsedWithBot;
    private List<Account> accounts = new();
    private List<BotCheckinAssistantPreset> presets = new();
    private List<BotCommandHistoryItem> recentCommands = new();
    private readonly HashSet<int> selectedAccountIds = new();
    private readonly HashSet<int> rememberedBotAccountIds = new();
    private readonly List<string> workflowMessages = new();
    private readonly List<AccountStepResult> currentStepResults = new();
    private readonly List<StepHistory> history = new();
    private readonly Dictionary<int, AccountTelegramToolsService.ResolvedChatTarget> resolvedTargets = new();
    private readonly Dictionary<int, string> resolvedBotUsernames = new();
    private CancellationTokenSource? runCts;

    private IEnumerable<Account> FilteredAccounts => accounts
        .Where(MatchesAccountFilter)
        .OrderBy(x => x.Id);

    private bool CanStart =>
        !running
        && !workflowActive
        && !string.IsNullOrWhiteSpace(botTarget)
        && selectedAccountIds.Count > 0
        && ParseScriptMessages(messageScript).Count > 0;

    private bool CanContinue => !running && HasNextStep;
    private bool CanStop => running || workflowActive;
    private bool CanReset => !running && (workflowActive || currentStepIndex >= 0 || history.Count > 0);
    private bool HasNextStep => workflowActive && currentStepIndex >= 0 && currentStepIndex + 1 < workflowMessages.Count;

    private Severity StartHintSeverity => CanStart ? Severity.Success : Severity.Warning;

    private string StartHintText
    {
        get
        {
            var scriptCount = ParseScriptMessages(messageScript).Count;

            if (running)
                return "正在执行中，请等待当前轮次完成。";
            if (workflowActive)
                return HasNextStep ? "当前轮已完成，可查看回复后点击“继续下一条”。" : "流程正在处理中，请留意状态提示。";
            if (string.IsNullOrWhiteSpace(botTarget))
                return "请先填写机器人用户名或链接。";
            if (selectedAccountIds.Count == 0)
                return "请至少选择一个账号。";
            if (scriptCount == 0)
                return "请至少填写一条要发送的消息。";
            return $"已就绪：{selectedAccountIds.Count} 个账号，{scriptCount} 条脚本。";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAccountsAsync();
        await ReloadPresetsAsync();
        await ReloadRecentCommandsAsync();
    }

    private async Task ReloadAccountsAsync()
    {
        loadingAccounts = true;
        try
        {
            accounts = (await AccountManagement.GetActiveAccountsAsync())
                .OrderBy(x => x.Id)
                .ToList();

            var validIds = accounts.Select(x => x.Id).ToHashSet();
            selectedAccountIds.RemoveWhere(id => !validIds.Contains(id));
            rememberedBotAccountIds.RemoveWhere(id => !validIds.Contains(id));
            currentStatusText = $"已加载 {accounts.Count} 个可用账号。";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Load accounts failed");
            currentStatusText = "加载账号失败";
            Snackbar.Add($"加载账号失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            loadingAccounts = false;
        }
    }

    private async Task ReloadPresetsAsync()
    {
        presets = (await PresetStore.GetPresetsAsync()).ToList();
        if (!string.IsNullOrWhiteSpace(selectedPresetName)
            && presets.All(x => !string.Equals(x.Name, selectedPresetName, StringComparison.OrdinalIgnoreCase)))
        {
            selectedPresetName = string.Empty;
        }
    }

    private async Task ReloadRecentCommandsAsync()
    {
        recentCommands = (await PresetStore.GetRecentCommandsAsync(12)).ToList();
    }

    private async Task OnBotTargetChangedAsync()
    {
        await LoadRememberedBotUsageAsync();
    }

    private async Task LoadRememberedBotUsageAsync()
    {
        rememberedBotAccountIds.Clear();
        foreach (var accountId in await PresetStore.GetRememberedBotAccountIdsAsync(botTarget))
            rememberedBotAccountIds.Add(accountId);

        if (rememberedBotAccountIds.Count > 0)
            currentStatusText = $"已读取该机器人本地常用账号 {rememberedBotAccountIds.Count} 个。";
    }

    private async Task ScanBotUsageFromTelegramAsync()
    {
        if (string.IsNullOrWhiteSpace(botTarget))
        {
            Snackbar.Add("请先填写机器人用户名或链接。", Severity.Warning);
            return;
        }

        loadingBotUsage = true;
        try
        {
            currentStatusText = "正在扫描各账号与该机器人的真实聊天历史，请稍候。";
            var matchedIds = await BotCompat.FindAccountsWithBotHistoryAsync(accounts, botTarget);
            rememberedBotAccountIds.Clear();
            foreach (var accountId in matchedIds)
                rememberedBotAccountIds.Add(accountId);

            await PresetStore.RememberBotAccountUsageAsync(botTarget, matchedIds);
            currentStatusText = $"扫描完成，找到 {matchedIds.Count} 个曾使用该机器人的账号。";
            Snackbar.Add($"扫描完成，找到 {matchedIds.Count} 个曾使用该机器人的账号。", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Scan bot usage failed");
            currentStatusText = "扫描机器人历史失败";
            Snackbar.Add($"扫描机器人历史失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            loadingBotUsage = false;
        }
    }

    private void ToggleUsedBotFilter()
    {
        showOnlyUsedWithBot = !showOnlyUsedWithBot;
    }

    private void SelectRememberedBotAccounts()
    {
        foreach (var accountId in rememberedBotAccountIds)
            selectedAccountIds.Add(accountId);

        Snackbar.Add($"已选择该机器人常用账号 {rememberedBotAccountIds.Count} 个。", Severity.Success);
    }

    private void ToggleAccountSelectionAsync(int accountId)
    {
        if (selectedAccountIds.Contains(accountId))
            selectedAccountIds.Remove(accountId);
        else
            selectedAccountIds.Add(accountId);
    }

    private Task SelectAllFiltered()
    {
        foreach (var account in FilteredAccounts)
            selectedAccountIds.Add(account.Id);

        Snackbar.Add($"已选择 {selectedAccountIds.Count} 个账号。", Severity.Success);
        return Task.CompletedTask;
    }

    private Task ClearSelection()
    {
        selectedAccountIds.Clear();
        Snackbar.Add("已清空账号选择。", Severity.Info);
        return Task.CompletedTask;
    }

    private async Task ApplyPresetSelectionAsync(string presetNameValue)
    {
        selectedPresetName = presetNameValue ?? string.Empty;
        if (string.IsNullOrWhiteSpace(selectedPresetName))
        {
            presetName = string.Empty;
            return;
        }

        var preset = presets.FirstOrDefault(x => string.Equals(x.Name, selectedPresetName, StringComparison.OrdinalIgnoreCase));
        if (preset == null)
        {
            Snackbar.Add("未找到选中的记录。", Severity.Warning);
            return;
        }

        botTarget = preset.BotTarget;
        startParameter = preset.StartParameter;
        autoStartBeforeFirstMessage = preset.AutoStartBeforeFirstMessage;
        waitTimeoutSeconds = preset.WaitTimeoutSeconds;
        delayBetweenAccountsSeconds = preset.DelayBetweenAccountsSeconds;
        messageScript = preset.MessageScript;
        presetName = preset.Name;

        selectedAccountIds.Clear();
        foreach (var accountId in preset.SelectedAccountIds)
        {
            if (accounts.Any(x => x.Id == accountId))
                selectedAccountIds.Add(accountId);
        }

        await LoadRememberedBotUsageAsync();
        currentStatusText = $"已载入记录“{preset.Name}”。";
        Snackbar.Add($"已载入记录“{preset.Name}”。", Severity.Success);
    }

    private async Task SaveCurrentPresetAsync()
    {
        var finalPresetName = (presetName ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(finalPresetName))
        {
            Snackbar.Add("请先填写记录名称。", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(botTarget))
        {
            Snackbar.Add("请先填写机器人用户名或链接。", Severity.Warning);
            return;
        }

        var commands = ParseScriptMessages(messageScript);
        if (commands.Count == 0)
        {
            Snackbar.Add("请至少填写一条脚本消息。", Severity.Warning);
            return;
        }

        await PresetStore.SavePresetAsync(new BotCheckinAssistantPreset(
            finalPresetName,
            botTarget.Trim(),
            startParameter.Trim(),
            autoStartBeforeFirstMessage,
            waitTimeoutSeconds,
            delayBetweenAccountsSeconds,
            messageScript,
            selectedAccountIds.OrderBy(x => x).ToList(),
            DateTimeOffset.UtcNow));

        await PresetStore.RememberCommandsAsync(commands);
        selectedPresetName = finalPresetName;
        await ReloadPresetsAsync();
        await ReloadRecentCommandsAsync();
        currentStatusText = $"已保存记录“{finalPresetName}”。";
        Snackbar.Add($"已保存记录“{finalPresetName}”。", Severity.Success);
    }

    private async Task DeleteSelectedPresetAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedPresetName))
            return;

        var deletingName = selectedPresetName;
        await PresetStore.DeletePresetAsync(deletingName);
        selectedPresetName = string.Empty;
        presetName = string.Empty;
        await ReloadPresetsAsync();
        currentStatusText = $"已删除记录“{deletingName}”。";
        Snackbar.Add($"已删除记录“{deletingName}”。", Severity.Info);
    }

    private void AppendCommandFromHistory(string command)
    {
        var value = (command ?? string.Empty).Trim();
        if (value.Length == 0)
            return;

        if (string.IsNullOrWhiteSpace(messageScript))
        {
            messageScript = value;
            return;
        }

        var existing = ParseScriptMessages(messageScript);
        if (!existing.Contains(value, StringComparer.OrdinalIgnoreCase))
            messageScript = $"{messageScript.TrimEnd()}{Environment.NewLine}{value}";
    }

    private async Task StartWorkflowAsync()
    {
        if (running)
            return;

        var messages = ParseScriptMessages(messageScript);
        if (messages.Count == 0)
        {
            Snackbar.Add("请至少填写一条脚本消息。", Severity.Warning);
            return;
        }

        if (selectedAccountIds.Count == 0)
        {
            Snackbar.Add("请先选择账号。", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(botTarget))
        {
            Snackbar.Add("请先填写机器人用户名或链接。", Severity.Warning);
            return;
        }

        await PresetStore.RememberCommandsAsync(messages);
        await ReloadRecentCommandsAsync();

        workflowMessages.Clear();
        workflowMessages.AddRange(messages);
        currentStepResults.Clear();
        history.Clear();
        resolvedTargets.Clear();
        resolvedBotUsernames.Clear();
        currentStepIndex = -1;
        workflowActive = true;
        currentStatusText = $"准备执行第 1 条，共 {selectedAccountIds.Count} 个账号。";

        Snackbar.Add($"开始执行第 1 条，目标账号 {selectedAccountIds.Count} 个。", Severity.Info);
        await ExecuteNextStepAsync();
    }

    private async Task ContinueWorkflowAsync()
    {
        if (!HasNextStep || running)
            return;

        currentStatusText = $"准备执行第 {currentStepIndex + 2} 条。";
        Snackbar.Add($"开始执行第 {currentStepIndex + 2} 条。", Severity.Info);
        await ExecuteNextStepAsync();
    }

    private Task StopWorkflow()
    {
        workflowActive = false;
        runCts?.Cancel();
        currentStatusText = "流程已停止。";
        Snackbar.Add("流程已停止。", Severity.Warning);
        return Task.CompletedTask;
    }

    private Task ResetWorkflow()
    {
        if (running)
            return Task.CompletedTask;

        workflowActive = false;
        currentStepIndex = -1;
        workflowMessages.Clear();
        currentStepResults.Clear();
        history.Clear();
        resolvedTargets.Clear();
        resolvedBotUsernames.Clear();
        currentStatusText = "流程已重置。";
        Snackbar.Add("流程已重置。", Severity.Info);
        return Task.CompletedTask;
    }

    private async Task ExecuteNextStepAsync()
    {
        if (!workflowActive)
            return;

        var stepIndex = currentStepIndex + 1;
        if (stepIndex < 0 || stepIndex >= workflowMessages.Count)
        {
            workflowActive = false;
            currentStatusText = "没有可执行的下一条脚本。";
            return;
        }

        await ExecuteStepAsync(stepIndex);
    }

    private async Task ExecuteStepAsync(int stepIndex)
    {
        var selectedAccounts = accounts
            .Where(x => selectedAccountIds.Contains(x.Id))
            .OrderBy(x => x.Id)
            .ToList();

        if (selectedAccounts.Count == 0)
        {
            workflowActive = false;
            currentStatusText = "当前没有可执行的已选账号。";
            Snackbar.Add("当前没有可执行的已选账号。", Severity.Warning);
            return;
        }

        var message = workflowMessages[stepIndex];
        var stepResults = new List<AccountStepResult>();
        var timeoutSeconds = Math.Clamp(waitTimeoutSeconds, 3, 300);
        var delaySeconds = Math.Clamp(delayBetweenAccountsSeconds, 0, 60);
        var successfulAccountIds = new List<int>();

        running = true;
        currentStepResults.Clear();
        runCts = new CancellationTokenSource();
        var cancellationToken = runCts.Token;
        currentStatusText = $"正在执行第 {stepIndex + 1} 条，共 {selectedAccounts.Count} 个账号。";
        StateHasChanged();

        try
        {
            for (var i = 0; i < selectedAccounts.Count; i++)
            {
                cancellationToken.ThrowIfCancellationRequested();

                var account = selectedAccounts[i];
                currentStatusText = $"正在处理账号 {i + 1}/{selectedAccounts.Count}：{BuildAccountLabel(account)}";
                StateHasChanged();

                var row = await ExecuteAccountStepAsync(account, message, stepIndex, timeoutSeconds, cancellationToken);
                if (row.SendSuccess)
                    successfulAccountIds.Add(account.Id);

                stepResults.Add(row);
                PushCurrentStepResults(stepResults);

                if (delaySeconds > 0 && i < selectedAccounts.Count - 1)
                    await Task.Delay(TimeSpan.FromSeconds(delaySeconds), cancellationToken);
            }

            if (successfulAccountIds.Count > 0)
            {
                await PresetStore.RememberBotAccountUsageAsync(botTarget, successfulAccountIds, cancellationToken);
                foreach (var id in successfulAccountIds)
                    rememberedBotAccountIds.Add(id);
            }

            currentStepIndex = stepIndex;
            currentStepResults.Clear();
            currentStepResults.AddRange(stepResults.Select(x => x.Clone()));
            history.Insert(0, new StepHistory
            {
                StepNumber = stepIndex + 1,
                Message = message,
                ExecutedAt = DateTimeOffset.Now,
                Results = stepResults.Select(x => x.Clone()).ToList()
            });

            if (currentStepIndex >= workflowMessages.Count - 1)
            {
                workflowActive = false;
                currentStatusText = "全部脚本已执行完成。";
                Snackbar.Add("全部脚本已执行完成。", Severity.Success);
            }
            else
            {
                currentStatusText = $"第 {currentStepIndex + 1} 条执行完成，请查看回复后决定是否继续。";
                Snackbar.Add($"第 {currentStepIndex + 1} 条执行完成。请查看回复后再决定是否继续。", Severity.Info);
            }
        }
        catch (OperationCanceledException) when (runCts?.IsCancellationRequested == true)
        {
            workflowActive = false;
            currentStatusText = "执行已取消。";
            Snackbar.Add("执行已取消。", Severity.Warning);
        }
        catch (OperationCanceledException ex)
        {
            workflowActive = false;
            currentStatusText = "执行被意外中断。";
            Logger.LogWarning(ex, "Bot check-in workflow interrupted unexpectedly");
            Snackbar.Add($"执行被意外中断：{ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            workflowActive = false;
            currentStatusText = "执行失败。";
            Logger.LogError(ex, "Execute bot check-in step failed");
            Snackbar.Add($"执行失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            running = false;
            runCts?.Dispose();
            runCts = null;
            StateHasChanged();
        }
    }

    private async Task<AccountStepResult> ExecuteAccountStepAsync(
        Account account,
        string message,
        int stepIndex,
        int timeoutSeconds,
        CancellationToken cancellationToken)
    {
        var row = new AccountStepResult
        {
            AccountId = account.Id,
            AccountLabel = BuildAccountLabel(account)
        };

        try
        {
            if (stepIndex == 0 && autoStartBeforeFirstMessage)
            {
                var start = await AccountTelegramTools.StartExternalBotAsync(
                    account.Id,
                    botTarget,
                    startParameter,
                    cancellationToken,
                    assumeBotUsername: true);
                if (!start.Success)
                {
                    row.Error = start.Error ?? "发送 /start 失败。";
                    return row;
                }
            }

            if (!resolvedTargets.TryGetValue(account.Id, out var target))
            {
                var resolve = await BotCompat.ResolveExternalBotTargetAsync(
                    account.Id,
                    botTarget,
                    cancellationToken,
                    assumeBotUsername: true);
                if (!resolve.Success || resolve.Target == null)
                {
                    row.Error = resolve.Error ?? "解析机器人目标失败。";
                    return row;
                }

                target = resolve.Target;
                resolvedTargets[account.Id] = target;
                if (!string.IsNullOrWhiteSpace(resolve.BotUsername))
                    resolvedBotUsernames[account.Id] = resolve.BotUsername;
            }

            var send = await AccountTelegramTools.SendMessageToResolvedChatAsync(
                account.Id,
                target,
                message,
                replyToMessageId: null,
                cancellationToken: cancellationToken);

            row.SendSuccess = send.Success;
            if (!send.Success || !send.MessageId.HasValue)
            {
                row.Error = send.Error ?? "发送消息失败。";
                return row;
            }

            var wait = await BotCompat.WaitForBotReplyAsync(
                account.Id,
                target,
                send.MessageId.Value,
                account.Username,
                timeoutSeconds,
                resolvedBotUsernames.GetValueOrDefault(account.Id),
                cancellationToken);

            if (!wait.Success || wait.Candidate == null)
            {
                row.Error = wait.Error ?? "未捕获到回复。";
                return row;
            }

            ApplyCandidateToResult(row, wait.Candidate);
            return row;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Bot check-in account execution failed: accountId={AccountId}", account.Id);
            row.Error = ex.Message;
            return row;
        }
    }

    private async Task ClickResponseButtonAsync(int accountId, int buttonIndex)
    {
        if (running)
            return;

        var row = currentStepResults.FirstOrDefault(x => x.AccountId == accountId);
        var account = accounts.FirstOrDefault(x => x.Id == accountId);
        if (row == null || account == null)
            return;

        var button = row.ResponseButtons.FirstOrDefault(x => x.Index == buttonIndex);
        if (button == null)
            return;

        if (!resolvedTargets.TryGetValue(accountId, out var target) || row.ResponseMessageId <= 0)
        {
            Snackbar.Add("当前没有可用的回复按钮上下文。", Severity.Warning);
            return;
        }

        activeResponseButtonKey = $"{accountId}:{buttonIndex}";
        currentStatusText = $"正在点击 {row.AccountLabel} 的回复按钮：{button.Text}";
        StateHasChanged();

        try
        {
            var click = await AccountTelegramTools.ClickInlineButtonAsync(
                accountId,
                target,
                row.ResponseMessageId,
                button.CallbackData);

            if (!click.Success)
            {
                row.Error = click.Error ?? "点击回复按钮失败。";
                Snackbar.Add(row.Error, Severity.Error);
                return;
            }

            var followUp = await BotCompat.WaitForBotReplyAsync(
                accountId,
                target,
                row.ResponseMessageId,
                account.Username,
                waitTimeoutSeconds,
                resolvedBotUsernames.GetValueOrDefault(accountId));

            if (!followUp.Success || followUp.Candidate == null)
            {
                row.Error = followUp.Error ?? "点击按钮后未捕获到新回复。";
                Snackbar.Add(row.Error, Severity.Warning);
                return;
            }

            ApplyCandidateToResult(row, followUp.Candidate);
            row.Error = null;
            currentStatusText = $"已更新 {row.AccountLabel} 的最新回复。";
            Snackbar.Add($"已更新 {row.AccountLabel} 的最新回复。", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ClickResponseButtonAsync failed");
            row.Error = ex.Message;
            Snackbar.Add($"点击回复按钮失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            activeResponseButtonKey = string.Empty;
            StateHasChanged();
        }
    }

    private void SelectFailedAccountsFromCurrentRound()
    {
        selectedAccountIds.Clear();
        foreach (var item in currentStepResults.Where(x => !x.SendSuccess || !x.ResponseSuccess))
            selectedAccountIds.Add(item.AccountId);

        Snackbar.Add($"已选中本轮需重试账号 {selectedAccountIds.Count} 个。", Severity.Info);
    }

    private void PushCurrentStepResults(IEnumerable<AccountStepResult> results)
    {
        currentStepResults.Clear();
        currentStepResults.AddRange(results.Select(x => x.Clone()));
        StateHasChanged();
    }

    private void ApplyCandidateToResult(AccountStepResult row, TelegramVerificationMessageCandidate candidate)
    {
        row.ResponseSuccess = true;
        row.ResponseMessageId = candidate.MessageId;
        row.ResponseText = NormalizeResponseText(candidate);
        row.ResponseButtonsSummary = BuildButtonsSummary(candidate);
        row.ResponseButtons = candidate.Buttons.ToList();
    }

    private bool MatchesAccountFilter(Account account)
    {
        if (showOnlyUsedWithBot && !rememberedBotAccountIds.Contains(account.Id))
            return false;

        var keyword = (accountSearch ?? string.Empty).Trim();
        if (keyword.Length == 0)
            return true;

        return (account.DisplayPhone ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
               || (account.Username ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
               || (account.Nickname ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
               || (account.Remark ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase);
    }

    private static List<string> ParseScriptMessages(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return new List<string>();

        return raw
            .Replace("\r", "\n", StringComparison.Ordinal)
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();
    }

    private static string BuildAccountLabel(Account account)
    {
        var name = !string.IsNullOrWhiteSpace(account.Username)
            ? $"@{account.Username}"
            : (!string.IsNullOrWhiteSpace(account.Nickname) ? account.Nickname! : account.DisplayPhone);
        return $"#{account.Id} {name}";
    }

    private static string DisplayName(Account account)
    {
        if (!string.IsNullOrWhiteSpace(account.Nickname) && !string.IsNullOrWhiteSpace(account.Remark))
            return $"{account.Nickname} / {account.Remark}";
        if (!string.IsNullOrWhiteSpace(account.Nickname))
            return account.Nickname;
        if (!string.IsNullOrWhiteSpace(account.Remark))
            return account.Remark;
        return "-";
    }

    private static string NormalizeResponseText(TelegramVerificationMessageCandidate candidate)
    {
        if (!string.IsNullOrWhiteSpace(candidate.Text))
            return candidate.Text.Trim();
        if (candidate.ImageJpegBytes is { Length: > 0 })
            return "[图片]";
        return "[无文本]";
    }

    private static string? BuildButtonsSummary(TelegramVerificationMessageCandidate candidate)
    {
        if (candidate.Buttons.Count == 0)
            return null;

        return string.Join(" | ", candidate.Buttons.Select(x => Shorten(x.Text, 16)));
    }

    private static string ToSingleLine(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "-";

        return Shorten(text.Replace("\r", " ", StringComparison.Ordinal).Replace("\n", " ", StringComparison.Ordinal), maxLength);
    }

    private static string Shorten(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "-";

        var value = text.Trim();
        if (value.Length <= maxLength)
            return value;

        return value[..maxLength] + "...";
    }

    private sealed class AccountStepResult
    {
        public int AccountId { get; init; }
        public string AccountLabel { get; init; } = string.Empty;
        public bool SendSuccess { get; set; }
        public bool ResponseSuccess { get; set; }
        public int ResponseMessageId { get; set; }
        public string? ResponseText { get; set; }
        public string? ResponseButtonsSummary { get; set; }
        public List<TelegramInlineButtonOption> ResponseButtons { get; set; } = new();
        public string? Error { get; set; }

        public AccountStepResult Clone()
        {
            return new AccountStepResult
            {
                AccountId = AccountId,
                AccountLabel = AccountLabel,
                SendSuccess = SendSuccess,
                ResponseSuccess = ResponseSuccess,
                ResponseMessageId = ResponseMessageId,
                ResponseText = ResponseText,
                ResponseButtonsSummary = ResponseButtonsSummary,
                ResponseButtons = ResponseButtons.Select(x => new TelegramInlineButtonOption(x.Index, x.Text, x.CallbackData.ToArray())).ToList(),
                Error = Error
            };
        }
    }

    private sealed class StepHistory
    {
        public int StepNumber { get; init; }
        public string Message { get; init; } = string.Empty;
        public DateTimeOffset ExecutedAt { get; init; }
        public List<AccountStepResult> Results { get; init; } = new();
    }
}
