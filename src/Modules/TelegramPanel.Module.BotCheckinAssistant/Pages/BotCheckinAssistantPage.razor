    private IEnumerable<Account> FilteredAccounts => accounts.Where(MatchesAccountFilter).OrderBy(x => x.Id);
    private bool CanStart => !running && !workflowActive && string.IsNullOrWhiteSpace(GetCurrentConfigValidationError());
    private bool CanContinue => !running && workflowActive && !(currentRunConfig?.AutoContinueAllSteps ?? autoContinueAllSteps) && HasNextStep;
    private bool CanStop => running || workflowActive;
    private bool CanReset => !running && (workflowActive || currentStepIndex >= 0 || history.Count > 0 || currentRunConfig != null);
    private bool HasNextStep => workflowActive && currentStepIndex >= 0 && currentStepIndex + 1 < workflowMessages.Count;
    private int CurrentViewStepNumber => Math.Max(currentStepIndex + 1, 1);
