    private string StartHintText
    {
        get
        {
            if (running)
                return "Running. Please wait for the current round to finish or stop it manually.";

            if (workflowActive && !(currentRunConfig?.AutoContinueAllSteps ?? false) && HasNextStep)
                return "\u5F53\u524D\u8FD9\u4E00\u6761\u5DF2\u7ECF\u6267\u884C\u5B8C\u6210\uFF0C\u8BF7\u5148\u67E5\u770B\u56DE\u590D\uFF0C\u518D\u51B3\u5B9A\u662F\u5426\u7EE7\u7EED\u4E0B\u4E00\u6761\u3002";

            if (workflowActive && (currentRunConfig?.AutoContinueAllSteps ?? false))
                return "Continuous run is in progress. Please watch the status area.";

            var error = GetCurrentConfigValidationError();
            if (!string.IsNullOrWhiteSpace(error))
                return error;

            var config = BuildCurrentConfig();
            return $"{TextHintReadyPrefix}{config.SelectedAccountIds.Count} \u4E2A\u8D26\u53F7\uFF0C{config.GetMessages().Count} \u6761\u811A\u672C\u3002";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAccountsAsync();
        await ReloadPresetsAsync();
        await ReloadRecentCommandsAsync();
        await LoadRememberedBotUsageAsync();
    }

    private async Task ReloadAccountsAsync()
    {
        loadingAccounts = true;
        try
        {
            accounts = (await AccountManagement.GetActiveAccountsAsync()).OrderBy(x => x.Id).ToList();
            var validIds = accounts.Select(x => x.Id).ToHashSet();
            selectedAccountIds.RemoveWhere(id => !validIds.Contains(id));
            rememberedBotAccountIds.RemoveWhere(id => !validIds.Contains(id));
            currentRunAccountIds.RemoveAll(id => !validIds.Contains(id));
            currentStatusText = $"Loaded {accounts.Count} accounts.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Load accounts failed");
            currentStatusText = "Failed to load accounts.";
            Snackbar.Add($"Load accounts failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            loadingAccounts = false;
        }
    }

    private async Task ReloadPresetsAsync()
    {
        presets = (await PresetStore.GetPresetsAsync()).ToList();
        if (!string.IsNullOrWhiteSpace(selectedPresetName)
            && presets.All(x => !string.Equals(x.Name, selectedPresetName, StringComparison.OrdinalIgnoreCase)))
        {
            selectedPresetName = string.Empty;
        }
    }

    private async Task ReloadRecentCommandsAsync()
    {
        recentCommands = (await PresetStore.GetRecentCommandsAsync(12)).ToList();
    }

    private async Task OnBotTargetChangedAsync()
    {
        await LoadRememberedBotUsageAsync();
    }

    private async Task LoadRememberedBotUsageAsync()
    {
        rememberedBotAccountIds.Clear();
        foreach (var accountId in await PresetStore.GetRememberedBotAccountIdsAsync(botTarget))
            rememberedBotAccountIds.Add(accountId);

        if (rememberedBotAccountIds.Count > 0)
            currentStatusText = $"Loaded {rememberedBotAccountIds.Count} remembered accounts for the bot.";
    }

    private async Task ScanBotUsageFromTelegramAsync()
    {
        if (string.IsNullOrWhiteSpace(botTarget))
        {
            Snackbar.Add("Please fill in the bot username or link first.", Severity.Warning);
            return;
        }

        loadingBotUsage = true;
        try
        {
            currentStatusText = "Scanning real Telegram chat history for the selected bot...";
            var matchedIds = await BotCompat.FindAccountsWithBotHistoryAsync(accounts, botTarget);
            rememberedBotAccountIds.Clear();
            foreach (var accountId in matchedIds)
                rememberedBotAccountIds.Add(accountId);

            await PresetStore.RememberBotAccountUsageAsync(botTarget, matchedIds);
            currentStatusText = $"Scan completed. Found {matchedIds.Count} matching accounts.";
            Snackbar.Add($"Scan completed. Found {matchedIds.Count} matching accounts.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Scan bot usage failed");
            currentStatusText = "Scan failed.";
            Snackbar.Add($"Scan failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            loadingBotUsage = false;
        }
    }

    private void ToggleUsedBotFilter()
    {
        showOnlyUsedWithBot = !showOnlyUsedWithBot;
    }

    private Task SelectRememberedBotAccountsAsync()
    {
        foreach (var accountId in rememberedBotAccountIds)
            selectedAccountIds.Add(accountId);

        Snackbar.Add($"Selected {rememberedBotAccountIds.Count} remembered accounts.", Severity.Success);
        return Task.CompletedTask;
    }

    private void ToggleAccountSelectionAsync(int accountId)
    {
        if (selectedAccountIds.Contains(accountId))
            selectedAccountIds.Remove(accountId);
        else
            selectedAccountIds.Add(accountId);
    }

    private Task SelectAllFilteredAsync()
    {
        foreach (var account in FilteredAccounts)
            selectedAccountIds.Add(account.Id);

        Snackbar.Add($"Selected {selectedAccountIds.Count} accounts.", Severity.Success);
        return Task.CompletedTask;
    }

    private Task ClearSelectionAsync()
    {
        selectedAccountIds.Clear();
        Snackbar.Add("Selection cleared.", Severity.Info);
        return Task.CompletedTask;
    }

    private async Task ApplyPresetSelectionAsync(string presetNameValue)
    {
        selectedPresetName = presetNameValue ?? string.Empty;
        if (string.IsNullOrWhiteSpace(selectedPresetName))
        {
            presetName = string.Empty;
            return;
        }

        var preset = presets.FirstOrDefault(x => string.Equals(x.Name, selectedPresetName, StringComparison.OrdinalIgnoreCase));
        if (preset == null)
        {
            Snackbar.Add("Preset not found.", Severity.Warning);
            return;
        }

        ApplyConfig(BotCheckinTaskConfig.FromPreset(preset));
        presetName = preset.Name;
        await LoadRememberedBotUsageAsync();
        currentStatusText = $"Preset loaded: {preset.Name}";
        Snackbar.Add($"Preset loaded: {preset.Name}", Severity.Success);
    }

    private async Task SaveCurrentPresetAsync()
    {
        var finalPresetName = (presetName ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(finalPresetName))
        {
            Snackbar.Add("Please enter a preset name first.", Severity.Warning);
            return;
        }

        var config = BuildCurrentConfig();
        var validationError = config.Validate();
        if (!string.IsNullOrWhiteSpace(validationError))
        {
            Snackbar.Add(validationError, Severity.Warning);
            return;
        }

        await PresetStore.SavePresetAsync(config.ToPreset(finalPresetName, DateTimeOffset.UtcNow));
        await PresetStore.RememberCommandsAsync(config.GetMessages());
        selectedPresetName = finalPresetName;
        await ReloadPresetsAsync();
        await ReloadRecentCommandsAsync();
        currentStatusText = $"Preset saved: {finalPresetName}";
        Snackbar.Add($"Preset saved: {finalPresetName}", Severity.Success);
    }

    private async Task DeleteSelectedPresetAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedPresetName))
            return;

        var deletingName = selectedPresetName;
        await PresetStore.DeletePresetAsync(deletingName);
        selectedPresetName = string.Empty;
        presetName = string.Empty;
        await ReloadPresetsAsync();
        currentStatusText = $"Preset deleted: {deletingName}";
        Snackbar.Add($"Preset deleted: {deletingName}", Severity.Info);
    }

    private void AppendCommandFromHistory(string command)
    {
        var value = (command ?? string.Empty).Trim();
        if (value.Length == 0)
            return;

        if (string.IsNullOrWhiteSpace(messageScript))
        {
            messageScript = value;
            return;
        }

        var existing = BotCheckinTaskConfig.ParseMessages(messageScript);
        if (!existing.Contains(value, StringComparer.OrdinalIgnoreCase))
            messageScript = $"{messageScript.TrimEnd()}{Environment.NewLine}{value}";
    }

    private async Task StartWorkflowAsync()
    {
        if (running)
            return;

        var config = BuildCurrentConfig();
        var validationError = config.Validate();
        if (!string.IsNullOrWhiteSpace(validationError))
        {
            Snackbar.Add(validationError, Severity.Warning);
            return;
        }

        await PresetStore.RememberCommandsAsync(config.GetMessages());
        await ReloadRecentCommandsAsync();

        PrepareNewWorkflow(config);
        currentStatusText = config.AutoContinueAllSteps
            ? $"Ready to run continuously. Accounts: {currentRunAccountIds.Count}, messages: {workflowMessages.Count}."
            : $"Ready to run step 1. Accounts: {currentRunAccountIds.Count}.";

        Snackbar.Add(
            config.AutoContinueAllSteps
                ? $"Continuous run started for {currentRunAccountIds.Count} accounts."
                : $"Step 1 started for {currentRunAccountIds.Count} accounts.",
            Severity.Info);

        if (config.AutoContinueAllSteps)
            await ExecuteContinuousWorkflowAsync();
        else
            await ExecuteSelectedStepAcrossAccountsAsync(0);
    }

    private async Task ContinueWorkflowAsync()
    {
        if (!HasNextStep || running || currentRunConfig == null)
            return;

        currentStatusText = $"Preparing step {currentStepIndex + 2}.";
        Snackbar.Add($"Step {currentStepIndex + 2} started.", Severity.Info);
        await ExecuteSelectedStepAcrossAccountsAsync(currentStepIndex + 1);
    }

    private Task StopWorkflowAsync()
    {
        workflowActive = false;
        runCts?.Cancel();
        currentStatusText = "Workflow stopped.";
        Snackbar.Add("Workflow stopped.", Severity.Warning);
        return Task.CompletedTask;
    }

    private Task ResetWorkflowAsync()
    {
        if (running)
            return Task.CompletedTask;

        workflowActive = false;
        currentStepIndex = -1;
        workflowMessages.Clear();
        currentStepResults.Clear();
        history.Clear();
        resolvedTargets.Clear();
        resolvedBotUsernames.Clear();
        stepResultBuffers.Clear();
        stepExecutionTimes.Clear();
        currentRunAccountIds.Clear();
        currentRunConfig = null;
        previewRow = null;
        currentStatusText = "Workflow reset.";
        Snackbar.Add("Workflow reset.", Severity.Info);
        return Task.CompletedTask;
    }

    private async Task ExecuteSelectedStepAcrossAccountsAsync(int stepIndex)
    {
        if (currentRunConfig == null)
            return;

        var selectedAccounts = GetCurrentRunAccounts();
        if (selectedAccounts.Count == 0)
        {
            workflowActive = false;
            currentStatusText = "No runnable selected accounts.";
            Snackbar.Add("No runnable selected accounts.", Severity.Warning);
            return;
        }

        var message = workflowMessages[stepIndex];
        running = true;
        runCts = new CancellationTokenSource();
        var cancellationToken = runCts.Token;
        currentStatusText = $"Running step {stepIndex + 1} for {selectedAccounts.Count} accounts.";
        StateHasChanged();

        try
        {
            for (var index = 0; index < selectedAccounts.Count; index++)
            {
                cancellationToken.ThrowIfCancellationRequested();

                var account = selectedAccounts[index];
                currentStatusText = $"Processing account {index + 1}/{selectedAccounts.Count}: {BuildAccountLabel(account)}";
                StateHasChanged();

                var row = await ExecuteAccountStepAsync(account, message, stepIndex, currentRunConfig, cancellationToken);
                AppendStepResult(stepIndex, row);

                if (index < selectedAccounts.Count - 1)
                {
                    var delaySeconds = currentRunConfig.GetNextAccountDelaySeconds();
                    if (delaySeconds > 0)
                    {
                        currentStatusText = $"{BuildAccountLabel(account)} done. Waiting {delaySeconds}s for the next account.";
                        StateHasChanged();
                        await Task.Delay(TimeSpan.FromSeconds(delaySeconds), cancellationToken);
                    }
                }
            }

            if (currentRunConfig.MarkRepliesAsRead)
            {
                await FinalizeReadStateForStepAsync(stepIndex, currentRunConfig, cancellationToken);
            }

            currentStepIndex = Math.Max(currentStepIndex, stepIndex);
            if (stepIndex >= workflowMessages.Count - 1)
            {
                workflowActive = false;
                currentStatusText = "All script messages completed.";
                Snackbar.Add("All script messages completed.", Severity.Success);
            }
            else
            {
                currentStatusText = $"Step {stepIndex + 1} finished. Review replies before continuing.";
                Snackbar.Add($"Step {stepIndex + 1} finished. Review replies before continuing.", Severity.Info);
            }
        }
        catch (OperationCanceledException) when (runCts?.IsCancellationRequested == true)
        {
            workflowActive = false;
            currentStatusText = "Execution canceled.";
            Snackbar.Add("Execution canceled.", Severity.Warning);
        }
        catch (OperationCanceledException ex)
        {
            workflowActive = false;
            currentStatusText = "Execution interrupted unexpectedly.";
            Logger.LogWarning(ex, "Bot check-in workflow interrupted unexpectedly");
            Snackbar.Add($"Execution interrupted unexpectedly: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            workflowActive = false;
            currentStatusText = "Execution failed.";
            Logger.LogError(ex, "ExecuteSelectedStepAcrossAccountsAsync failed");
            Snackbar.Add($"Execution failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            running = false;
            runCts?.Dispose();
            runCts = null;
            StateHasChanged();
        }
    }

    private async Task ExecuteContinuousWorkflowAsync()
    {
        if (currentRunConfig == null)
            return;

        var selectedAccounts = GetCurrentRunAccounts();
        if (selectedAccounts.Count == 0)
        {
            workflowActive = false;
            currentStatusText = "No runnable selected accounts.";
            Snackbar.Add("No runnable selected accounts.", Severity.Warning);
            return;
        }

        running = true;
        runCts = new CancellationTokenSource();
        var cancellationToken = runCts.Token;
        currentStatusText = $"Running continuously. Accounts: {selectedAccounts.Count}, messages: {workflowMessages.Count}.";
        StateHasChanged();

        try
        {
            for (var accountIndex = 0; accountIndex < selectedAccounts.Count; accountIndex++)
            {
                cancellationToken.ThrowIfCancellationRequested();

                var account = selectedAccounts[accountIndex];
                for (var stepIndex = 0; stepIndex < workflowMessages.Count; stepIndex++)
                {
                    cancellationToken.ThrowIfCancellationRequested();
                    currentStatusText = $"Account {accountIndex + 1}/{selectedAccounts.Count}, message {stepIndex + 1}/{workflowMessages.Count}: {BuildAccountLabel(account)}";
                    StateHasChanged();

                    var row = await ExecuteAccountStepAsync(account, workflowMessages[stepIndex], stepIndex, currentRunConfig, cancellationToken);
                    AppendStepResult(stepIndex, row);
                }

                if (currentRunConfig.MarkRepliesAsRead)
                {
                    currentStatusText = $"Finalizing read state for {BuildAccountLabel(account)}.";
                    StateHasChanged();

                    var markedAsRead = await TryFinalizeAccountReadStateAsync(account.Id, currentRunConfig, cancellationToken);
                    SetBufferedReadStatusForAccount(account.Id, markedAsRead);
                }

                if (accountIndex < selectedAccounts.Count - 1)
                {
                    var delaySeconds = currentRunConfig.GetNextAccountDelaySeconds();
                    if (delaySeconds > 0)
                    {
                        currentStatusText = $"{BuildAccountLabel(account)} finished. Waiting {delaySeconds}s for the next account.";
                        StateHasChanged();
                        await Task.Delay(TimeSpan.FromSeconds(delaySeconds), cancellationToken);
                    }
                }
            }

            workflowActive = false;
            currentStepIndex = workflowMessages.Count - 1;
            currentStatusText = "Continuous run completed.";
            Snackbar.Add("Continuous run completed.", Severity.Success);
        }
        catch (OperationCanceledException) when (runCts?.IsCancellationRequested == true)
        {
            workflowActive = false;
            currentStatusText = "Continuous run canceled.";
            Snackbar.Add("Continuous run canceled.", Severity.Warning);
        }
        catch (OperationCanceledException ex)
        {
            workflowActive = false;
            currentStatusText = "Continuous run interrupted unexpectedly.";
            Logger.LogWarning(ex, "Bot check-in continuous workflow interrupted unexpectedly");
            Snackbar.Add($"Continuous run interrupted unexpectedly: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            workflowActive = false;
            currentStatusText = "Continuous run failed.";
            Logger.LogError(ex, "ExecuteContinuousWorkflowAsync failed");
            Snackbar.Add($"Continuous run failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            running = false;
            runCts?.Dispose();
            runCts = null;
            StateHasChanged();
        }
    }

    private async Task<AccountStepResult> ExecuteAccountStepAsync(Account account, string message, int stepIndex, BotCheckinTaskConfig config, CancellationToken cancellationToken)
    {
        var row = new AccountStepResult { AccountId = account.Id, AccountLabel = BuildAccountLabel(account) };

        try
        {
            if (!resolvedTargets.TryGetValue(account.Id, out var target))
            {
                var resolve = await BotCompat.ResolveExternalBotTargetAsync(account.Id, config.BotTarget, cancellationToken, assumeBotUsername: true);
                if (!resolve.Success || resolve.Target == null)
                {
                    row.Error = resolve.Error ?? "Resolve bot target failed.";
                    return row;
                }

                target = resolve.Target;
                resolvedTargets[account.Id] = target;
                if (!string.IsNullOrWhiteSpace(resolve.BotUsername))
                    resolvedBotUsernames[account.Id] = resolve.BotUsername;
            }

            var normalizedMessage = (message ?? string.Empty).Trim();
            if (stepIndex == 0 && config.AutoStartBeforeFirstMessage && !string.Equals(normalizedMessage, "/start", StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrWhiteSpace(config.StartParameter))
                {
                    var start = await AccountTelegramTools.StartExternalBotAsync(account.Id, config.BotTarget, config.StartParameter, cancellationToken, assumeBotUsername: true);
                    if (!start.Success)
                    {
                        row.Error = start.Error ?? "Send /start with parameter failed.";
                        return row;
                    }
                }
                else
                {
                    var plainStart = await AccountTelegramTools.SendMessageToResolvedChatAsync(account.Id, target, "/start", replyToMessageId: null, cancellationToken: cancellationToken);
                    if (!plainStart.Success)
                    {
                        row.Error = plainStart.Error ?? "Send /start failed.";
                        return row;
                    }
                }
            }

            var send = await AccountTelegramTools.SendMessageToResolvedChatAsync(account.Id, target, normalizedMessage, replyToMessageId: null, cancellationToken: cancellationToken);
            row.SendSuccess = send.Success;
            if (!send.Success || !send.MessageId.HasValue)
            {
                row.Error = send.Error ?? "Send message failed.";
                return row;
            }

            var wait = await BotCompat.WaitForBotReplyAsync(
                account.Id,
                target,
                send.MessageId.Value,
                account.Username,
                config.WaitTimeoutSeconds,
                resolvedBotUsernames.TryGetValue(account.Id, out var botUsername) ? botUsername : null,
                config.MarkRepliesAsRead,
                cancellationToken);

            if (!wait.Success || wait.Candidate == null)
            {
                row.Error = wait.Error ?? "Reply was not captured.";
                return row;
            }

            ApplyCandidateToResult(row, wait.Candidate, wait.MarkedAsRead);
            return row;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Bot check-in account execution failed: accountId={AccountId}", account.Id);
            row.Error = ex.Message;
            return row;
        }
    }

    private async Task ClickResponseButtonAsync(int accountId, int buttonIndex)
    {
        if (running)
            return;

        var row = currentStepResults.FirstOrDefault(x => x.AccountId == accountId);
        var account = accounts.FirstOrDefault(x => x.Id == accountId);
        if (row == null || account == null)
            return;

        var button = row.ResponseButtons.FirstOrDefault(x => x.Index == buttonIndex);
        if (button == null)
            return;

        if (!resolvedTargets.TryGetValue(accountId, out var target) || row.ResponseMessageId <= 0)
        {
            Snackbar.Add("The reply button context is not available.", Severity.Warning);
            return;
        }

        activeResponseButtonKey = $"{accountId}:{buttonIndex}";
        currentStatusText = $"Clicking reply button for {row.AccountLabel}: {button.Text}";
        StateHasChanged();

        try
        {
            var click = await AccountTelegramTools.ClickInlineButtonAsync(accountId, target, row.ResponseMessageId, button.CallbackData);
            if (!click.Success)
            {
                row.Error = click.Error ?? "Click reply button failed.";
                Snackbar.Add(row.Error, Severity.Error);
                return;
            }

            var config = currentRunConfig ?? BuildCurrentConfig();
            var followUp = await BotCompat.WaitForBotReplyAsync(
                accountId,
                target,
                row.ResponseMessageId,
                account.Username,
                config.WaitTimeoutSeconds,
                resolvedBotUsernames.TryGetValue(accountId, out var botUsername) ? botUsername : null,
                config.MarkRepliesAsRead);

            if (!followUp.Success || followUp.Candidate == null)
            {
                row.Error = followUp.Error ?? "No new reply was captured after clicking the button.";
                Snackbar.Add(row.Error, Severity.Warning);
                return;
            }

            var markedAsRead = followUp.MarkedAsRead;
            if (config.MarkRepliesAsRead)
            {
                currentStatusText = $"Finalizing read state for {row.AccountLabel}.";
                StateHasChanged();
                markedAsRead = await TryFinalizeAccountReadStateAsync(accountId, config, CancellationToken.None);
            }

            ApplyCandidateToResult(row, followUp.Candidate, markedAsRead);
            row.Error = null;
            UpdateBufferedRow(row);
            if (previewRow?.AccountId == row.AccountId)
                previewRow = row.Clone();

            currentStatusText = $"Updated latest reply for {row.AccountLabel}.";
            Snackbar.Add($"Updated latest reply for {row.AccountLabel}.", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ClickResponseButtonAsync failed");
            row.Error = ex.Message;
            Snackbar.Add($"Click reply button failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            activeResponseButtonKey = string.Empty;
            StateHasChanged();
        }
    }

    private Task SelectFailedAccountsFromCurrentRoundAsync()
    {
        selectedAccountIds.Clear();
        foreach (var item in currentStepResults.Where(HasRowIssue))
            selectedAccountIds.Add(item.AccountId);

        Snackbar.Add($"Selected {selectedAccountIds.Count} failed accounts from the current round.", Severity.Info);
        return Task.CompletedTask;
    }

    private void ShowReplyPreview(AccountStepResult row)
    {
        previewRow = row.Clone();
    }

    private void ClosePreview()
    {
        previewRow = null;
    }

    private void AppendStepResult(int stepIndex, AccountStepResult row)
    {
        if (!stepResultBuffers.TryGetValue(stepIndex, out var buffer))
        {
            buffer = new List<AccountStepResult>();
            stepResultBuffers[stepIndex] = buffer;
        }

        var existingIndex = buffer.FindIndex(x => x.AccountId == row.AccountId);
        if (existingIndex >= 0)
            buffer[existingIndex] = row.Clone();
        else
            buffer.Add(row.Clone());

        stepExecutionTimes[stepIndex] = DateTimeOffset.Now;
        currentStepIndex = Math.Max(currentStepIndex, stepIndex);
        currentStepResults.Clear();
        currentStepResults.AddRange(buffer.OrderBy(x => x.AccountId).Select(x => x.Clone()));
        RefreshHistory();
        StateHasChanged();
    }

    private void UpdateBufferedRow(AccountStepResult row)
    {
        if (!stepResultBuffers.TryGetValue(currentStepIndex, out var currentBuffer))
            return;

        var currentIndex = currentBuffer.FindIndex(x => x.AccountId == row.AccountId);
        if (currentIndex >= 0)
            currentBuffer[currentIndex] = row.Clone();

        currentStepResults.Clear();
        currentStepResults.AddRange(currentBuffer.OrderBy(x => x.AccountId).Select(x => x.Clone()));
        RefreshHistory();
    }

    private async Task FinalizeReadStateForStepAsync(int stepIndex, BotCheckinTaskConfig config, CancellationToken cancellationToken)
    {
        if (!config.MarkRepliesAsRead || !stepResultBuffers.TryGetValue(stepIndex, out var buffer))
            return;

        foreach (var row in buffer
                     .Where(x => x.ResponseSuccess && resolvedTargets.ContainsKey(x.AccountId))
                     .OrderBy(x => x.AccountId)
                     .ToList())
        {
            cancellationToken.ThrowIfCancellationRequested();

            currentStatusText = $"Finalizing read state for {row.AccountLabel}.";
            StateHasChanged();

            var markedAsRead = await TryFinalizeAccountReadStateAsync(row.AccountId, config, cancellationToken);
            SetBufferedRowReadStatus(stepIndex, row.AccountId, markedAsRead);
        }
    }

    private async Task<bool> TryFinalizeAccountReadStateAsync(int accountId, BotCheckinTaskConfig config, CancellationToken cancellationToken)
    {
        if (!config.MarkRepliesAsRead || !resolvedTargets.TryGetValue(accountId, out var target))
            return false;

        return await BotCompat.TryFinalizeChatAsReadAsync(
            accountId,
            target,
            settleSeconds: 5,
            cancellationToken: cancellationToken);
    }

    private void SetBufferedRowReadStatus(int stepIndex, int accountId, bool markedAsRead)
    {
        if (!stepResultBuffers.TryGetValue(stepIndex, out var buffer))
            return;

        var changed = false;
        foreach (var row in buffer.Where(x => x.AccountId == accountId && x.ResponseSuccess))
        {
            row.MarkedAsRead = markedAsRead;
            changed = true;
        }

        if (!changed)
            return;

        if (currentStepIndex == stepIndex)
        {
            currentStepResults.Clear();
            currentStepResults.AddRange(buffer.OrderBy(x => x.AccountId).Select(x => x.Clone()));
        }

        if (previewRow?.AccountId == accountId && previewRow.ResponseSuccess)
            previewRow.MarkedAsRead = markedAsRead;

        RefreshHistory();
    }

    private void SetBufferedReadStatusForAccount(int accountId, bool markedAsRead)
    {
        var changed = false;
        foreach (var entry in stepResultBuffers)
        {
            foreach (var row in entry.Value.Where(x => x.AccountId == accountId && x.ResponseSuccess))
            {
                row.MarkedAsRead = markedAsRead;
                changed = true;
            }
        }

        if (!changed)
            return;

        if (stepResultBuffers.TryGetValue(currentStepIndex, out var currentBuffer))
        {
            currentStepResults.Clear();
            currentStepResults.AddRange(currentBuffer.OrderBy(x => x.AccountId).Select(x => x.Clone()));
        }

        if (previewRow?.AccountId == accountId && previewRow.ResponseSuccess)
            previewRow.MarkedAsRead = markedAsRead;

        RefreshHistory();
    }

    private void RefreshHistory()
    {
        history.Clear();
        foreach (var stepIndex in stepResultBuffers.Keys.OrderByDescending(x => x))
        {
            history.Add(new StepHistory
            {
                StepNumber = stepIndex + 1,
                Message = workflowMessages.ElementAtOrDefault(stepIndex) ?? string.Empty,
                ExecutedAt = stepExecutionTimes.TryGetValue(stepIndex, out var executedAt) ? executedAt : DateTimeOffset.Now,
                Results = stepResultBuffers[stepIndex].OrderBy(x => x.AccountId).Select(x => x.Clone()).ToList()
            });
        }
    }

    private void ApplyCandidateToResult(AccountStepResult row, TelegramVerificationMessageCandidate candidate, bool markAsRead)
    {
        row.ResponseSuccess = true;
        row.ResponseMessageId = candidate.MessageId;
        row.ResponseText = NormalizeResponseText(candidate);
        row.ResponseButtonsSummary = BuildButtonsSummary(candidate);
        row.ResponseButtons = candidate.Buttons.ToList();
        row.MarkedAsRead = markAsRead;
    }

    private bool MatchesAccountFilter(Account account)
    {
        if (showOnlyUsedWithBot && !rememberedBotAccountIds.Contains(account.Id))
            return false;

        var keyword = (accountSearch ?? string.Empty).Trim();
        if (keyword.Length == 0)
            return true;

        return (account.DisplayPhone ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
               || (account.Username ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
               || (account.Nickname ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
               || (account.Remark ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase);
    }

    private void PrepareNewWorkflow(BotCheckinTaskConfig config)
    {
        currentRunConfig = config;
        workflowMessages.Clear();
        workflowMessages.AddRange(config.GetMessages());
        currentRunAccountIds.Clear();
        currentRunAccountIds.AddRange(config.SelectedAccountIds);
        currentStepIndex = -1;
        workflowActive = true;
        currentStepResults.Clear();
        history.Clear();
        resolvedTargets.Clear();
        resolvedBotUsernames.Clear();
        stepResultBuffers.Clear();
        stepExecutionTimes.Clear();
        previewRow = null;
    }

    private List<Account> GetCurrentRunAccounts()
    {
        var ids = currentRunAccountIds.ToHashSet();
        return accounts.Where(x => ids.Contains(x.Id)).OrderBy(x => x.Id).ToList();
    }

    private BotCheckinTaskConfig BuildCurrentConfig()
    {
        return new BotCheckinTaskConfig
        {
            TaskName = presetName,
            BotTarget = botTarget,
            StartParameter = startParameter,
            AutoStartBeforeFirstMessage = autoStartBeforeFirstMessage,
            WaitTimeoutSeconds = waitTimeoutSeconds,
            DelayBetweenAccountsSeconds = delayBetweenAccountsSeconds,
            EnableRandomDelay = enableRandomDelay,
            RandomDelayMinSeconds = randomDelayMinSeconds,
            RandomDelayMaxSeconds = randomDelayMaxSeconds,
            AutoContinueAllSteps = autoContinueAllSteps,
            MarkRepliesAsRead = markRepliesAsRead,
            MessageScript = messageScript,
            SelectedAccountIds = selectedAccountIds.OrderBy(x => x).ToList()
        };
    }

    private string? GetCurrentConfigValidationError()
    {
        return BuildCurrentConfig().Validate();
    }

    private void ApplyConfig(BotCheckinTaskConfig config)
    {
        config.Normalize();
        botTarget = config.BotTarget;
        startParameter = config.StartParameter;
        autoStartBeforeFirstMessage = config.AutoStartBeforeFirstMessage;
        waitTimeoutSeconds = config.WaitTimeoutSeconds;
        delayBetweenAccountsSeconds = config.DelayBetweenAccountsSeconds;
        enableRandomDelay = config.EnableRandomDelay;
        randomDelayMinSeconds = config.RandomDelayMinSeconds;
        randomDelayMaxSeconds = config.RandomDelayMaxSeconds;
        autoContinueAllSteps = config.AutoContinueAllSteps;
        markRepliesAsRead = config.MarkRepliesAsRead;
        messageScript = config.MessageScript;

        selectedAccountIds.Clear();
        foreach (var accountId in config.SelectedAccountIds.Where(x => accounts.Any(a => a.Id == x)))
            selectedAccountIds.Add(accountId);
    }

    private static bool HasRowIssue(AccountStepResult row)
    {
        return !row.SendSuccess || !row.ResponseSuccess || !string.IsNullOrWhiteSpace(row.Error);
    }

    private static string BuildAccountLabel(Account account)
    {
        var name = !string.IsNullOrWhiteSpace(account.Username)
            ? $"@{account.Username}"
            : (!string.IsNullOrWhiteSpace(account.Nickname) ? account.Nickname! : account.DisplayPhone);
        return $"#{account.Id} {name}";
    }

    private static string DisplayName(Account account)
    {
        if (!string.IsNullOrWhiteSpace(account.Nickname) && !string.IsNullOrWhiteSpace(account.Remark))
            return $"{account.Nickname} / {account.Remark}";
        if (!string.IsNullOrWhiteSpace(account.Nickname))
            return account.Nickname;
        if (!string.IsNullOrWhiteSpace(account.Remark))
            return account.Remark;
        return "-";
    }

    private static string NormalizeResponseText(TelegramVerificationMessageCandidate candidate)
    {
        if (!string.IsNullOrWhiteSpace(candidate.Text))
            return candidate.Text.Trim();
        if (candidate.ImageJpegBytes is { Length: > 0 })
            return "[image]";
        return "[no text reply]";
    }

    private static string? BuildButtonsSummary(TelegramVerificationMessageCandidate candidate)
    {
        if (candidate.Buttons.Count == 0)
            return null;

        return string.Join(" | ", candidate.Buttons.Select(x => Shorten(x.Text, 16)));
    }

    private static string ShortenMultiline(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "-";

        return Shorten(text.Replace("\r", " ", StringComparison.Ordinal).Replace("\n", " ", StringComparison.Ordinal), maxLength);
    }

    private static string Shorten(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "-";

        var value = text.Trim();
        if (value.Length <= maxLength)
            return value;

        return value[..maxLength] + "...";
    }

    private sealed class AccountStepResult
    {
        public int AccountId { get; init; }
        public string AccountLabel { get; init; } = string.Empty;
        public bool SendSuccess { get; set; }
        public bool ResponseSuccess { get; set; }
        public bool MarkedAsRead { get; set; }
        public int ResponseMessageId { get; set; }
        public string? ResponseText { get; set; }
        public string? ResponseButtonsSummary { get; set; }
        public List<TelegramInlineButtonOption> ResponseButtons { get; set; } = new();
        public string? Error { get; set; }

        public AccountStepResult Clone()
        {
            return new AccountStepResult
            {
                AccountId = AccountId,
                AccountLabel = AccountLabel,
                SendSuccess = SendSuccess,
                ResponseSuccess = ResponseSuccess,
                MarkedAsRead = MarkedAsRead,
                ResponseMessageId = ResponseMessageId,
                ResponseText = ResponseText,
                ResponseButtonsSummary = ResponseButtonsSummary,
                ResponseButtons = ResponseButtons.Select(x => new TelegramInlineButtonOption(x.Index, x.Text, x.CallbackData.ToArray())).ToList(),
                Error = Error
            };
        }
    }

    private sealed class StepHistory
    {
        public int StepNumber { get; init; }
        public string Message { get; init; } = string.Empty;
        public DateTimeOffset ExecutedAt { get; init; }
        public List<AccountStepResult> Results { get; init; } = new();
    }
}
