    private const string TextSelectRemembered = "\u4E00\u952E\u9009\u62E9\u8BE5\u673A\u5668\u4EBA\u5E38\u7528\u8D26\u53F7";
    private const string TextShowAllAccounts = "\u663E\u793A\u5168\u90E8\u8D26\u53F7";
