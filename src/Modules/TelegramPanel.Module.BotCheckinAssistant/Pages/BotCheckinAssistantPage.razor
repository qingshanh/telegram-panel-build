    private const string TextColumnPhone = "\u624B\u673A\u53F7";
    private const string TextColumnUsername = "\u7528\u6237\u540D";
    private const string TextColumnDisplay = "\u663E\u793A\u540D / \u5907\u6CE8";
    private const string TextColumnRemembered = "\u8BE5\u673A\u5668\u4EBA\u5E38\u7528";
    private const string TextChoose = "\u9009\u62E9";
