@namespace TelegramPanel.Module.BotCheckinAssistant.Pages
@inject AccountManagementService AccountManagement
@inject AccountTelegramToolsService AccountTelegramTools
@inject ISnackbar Snackbar
@inject ILogger<BotCheckinAssistantPage> Logger

<PageTitle>机器人签到助手</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4 tp-page-title">机器人签到助手</MudText>

<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudStack Spacing="2">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            按脚本批量给同一个机器人发消息。每执行完一轮，可先查看各账号返回内容，再决定继续下一条还是停止。
        </MudAlert>

        <MudTextField @bind-Value="botTarget"
                      Label="机器人用户名或链接"
                      Variant="Variant.Outlined"
                      Placeholder="@BotTargetPlaceholder"
                      Disabled="@running"
                      Immediate="true" />

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="startParameter"
                              Label="/start 参数（可选）"
                              Variant="Variant.Outlined"
                              Placeholder="invite_abc"
                              Disabled="@running" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField T="int" @bind-Value="waitTimeoutSeconds"
                                 Label="等待回复超时（秒）"
                                 Variant="Variant.Outlined"
                                 Min="3"
                                 Max="300"
                                 Disabled="@running" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField T="int" @bind-Value="delayBetweenAccountsSeconds"
                                 Label="账号间隔（秒）"
                                 Variant="Variant.Outlined"
                                 Min="0"
                                 Max="60"
                                 Disabled="@running" />
            </MudItem>
        </MudGrid>

        <MudSwitch @bind-Value="autoStartBeforeFirstMessage"
                   Label="首条脚本前先发送 /start"
                   Disabled="@running" />

        <MudTextField @bind-Value="messageScript"
                      Label="消息脚本（每行一条）"
                      Variant="Variant.Outlined"
                      Lines="6"
                      Immediate="true"
                      Disabled="@running"
                      HelperText="示例：/start、签到、查询积分。每行只写一条消息。" />

        <MudDivider />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">账号列表</MudText>
            <MudChip T="string" Color="Color.Primary" Size="Size.Small">已选择 @selectedAccountIds.Count / @accounts.Count</MudChip>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@(running || loadingAccounts)"
                       OnClick="ReloadAccountsAsync">
                刷新账号
            </MudButton>
        </MudStack>

        <MudTextField @bind-Value="accountSearch"
                      Label="搜索账号"
                      Placeholder="手机号 / 用户名 / 昵称 / 备注"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Disabled="@running" />

        <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@running" OnClick="SelectAllFiltered">
                选择当前筛选
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="@running" OnClick="ClearSelection">
                清空选择
            </MudButton>
        </MudStack>

        <MudTable Items="FilteredAccounts"
                  Dense="true"
                  Hover="true"
                  Loading="@loadingAccounts"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>选择</MudTh>
                <MudTh>ID</MudTh>
                <MudTh>手机号</MudTh>
                <MudTh>用户名</MudTh>
                <MudTh>昵称 / 备注</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="选择">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="@(selectedAccountIds.Contains(context.Id) ? Color.Success : Color.Default)"
                               Disabled="@running"
                               OnClick="@(() => ToggleAccountSelectionAsync(context.Id))">
                        @(selectedAccountIds.Contains(context.Id) ? "已选中" : "选择")
                    </MudButton>
                </MudTd>
                <MudTd DataLabel="ID">@context.Id</MudTd>
                <MudTd DataLabel="手机号">@context.DisplayPhone</MudTd>
                <MudTd DataLabel="用户名">@(!string.IsNullOrWhiteSpace(context.Username) ? $"@{context.Username}" : "-")</MudTd>
                <MudTd DataLabel="昵称 / 备注">@DisplayName(context)</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>没有匹配到账号。</MudText>
            </NoRecordsContent>
        </MudTable>

        <MudDivider />

        <MudAlert Severity="@StartHintSeverity" Variant="Variant.Outlined" Dense="true">
            @StartHintText
        </MudAlert>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       Disabled="@(!CanStart)"
                       OnClick="StartWorkflowAsync">
                开始第 1 条
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.SkipNext"
                       Disabled="@(!CanContinue)"
                       OnClick="ContinueWorkflowAsync">
                继续下一条
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Stop"
                       Disabled="@(!CanStop)"
                       OnClick="StopWorkflow">
                停止
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       Disabled="@(!CanReset)"
                       OnClick="ResetWorkflow">
                重置
            </MudButton>
        </MudStack>

        @if (running)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                正在执行第 @(currentStepIndex + 2) 条：@Shorten(workflowMessages.ElementAtOrDefault(currentStepIndex + 1), 120)
            </MudAlert>
        }
        else if (workflowActive && HasNextStep)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                第 @(currentStepIndex + 1) 条已完成。请先查看返回结果，再决定是否继续下一条：@Shorten(workflowMessages[currentStepIndex + 1], 120)
            </MudAlert>
        }
        else if (!workflowActive && currentStepIndex >= 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                流程已停止。可点击“重置”后重新开始。
            </MudAlert>
        }
    </MudStack>
</MudPaper>

@if (currentStepResults.Count > 0)
{
    <MudPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">当前轮次：第 @(currentStepIndex + 1) 条</MudText>
        <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
            发送内容：@Shorten(workflowMessages[currentStepIndex], 200)
        </MudText>
        <MudTable Items="currentStepResults" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>账号</MudTh>
                <MudTh>发送</MudTh>
                <MudTh>回复</MudTh>
                <MudTh>回复内容</MudTh>
                <MudTh>按钮</MudTh>
                <MudTh>错误</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="账号">@context.AccountLabel</MudTd>
                <MudTd DataLabel="发送">
                    <MudChip T="string" Size="Size.Small" Color="@(context.SendSuccess ? Color.Success : Color.Error)">
                        @(context.SendSuccess ? "成功" : "失败")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="回复">
                    <MudChip T="string" Size="Size.Small" Color="@(context.ResponseSuccess ? Color.Success : Color.Default)">
                        @(context.ResponseSuccess ? "已捕获" : "无")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="回复内容">@ToSingleLine(context.ResponseText, 80)</MudTd>
                <MudTd DataLabel="按钮">@ToSingleLine(context.ButtonsSummary, 60)</MudTd>
                <MudTd DataLabel="错误">@ToSingleLine(context.Error, 80)</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@if (history.Count > 0)
{
    <MudPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">执行历史</MudText>
        <MudTable Items="history" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>时间</MudTh>
                <MudTh>脚本行</MudTh>
                <MudTh>消息</MudTh>
                <MudTh>发送成功</MudTh>
                <MudTh>捕获回复</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="时间">@context.ExecutedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                <MudTd DataLabel="脚本行">@context.StepNumber</MudTd>
                <MudTd DataLabel="消息">@Shorten(context.Message, 80)</MudTd>
                <MudTd DataLabel="发送成功">@($"{context.Results.Count(x => x.SendSuccess)}/{context.Results.Count}")</MudTd>
                <MudTd DataLabel="捕获回复">@($"{context.Results.Count(x => x.ResponseSuccess)}/{context.Results.Count}")</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    [Parameter] public string ModuleId { get; set; } = "";
    [Parameter] public string PageKey { get; set; } = "";

    private bool loadingAccounts = true;
    private bool running;
    private bool workflowActive;
    private int currentStepIndex = -1;

    private string botTarget = string.Empty;
    private const string BotTargetPlaceholder = "examplebot 或 https://t.me/examplebot";
    private string startParameter = string.Empty;
    private bool autoStartBeforeFirstMessage = true;
    private int waitTimeoutSeconds = 25;
    private int delayBetweenAccountsSeconds = 2;
    private string messageScript = "/start\n签到\n查询积分";
    private string accountSearch = string.Empty;

    private List<Account> accounts = new();
    private readonly HashSet<int> selectedAccountIds = new();
    private readonly List<string> workflowMessages = new();
    private readonly List<AccountStepResult> currentStepResults = new();
    private readonly List<StepHistory> history = new();
    private readonly Dictionary<int, AccountTelegramToolsService.ResolvedChatTarget> resolvedTargets = new();
    private readonly Dictionary<int, string> resolvedBotUsernames = new();
    private CancellationTokenSource? runCts;

    private IEnumerable<Account> FilteredAccounts => accounts.Where(MatchesAccountSearch).OrderBy(x => x.Id);

    private bool CanStart =>
        !running
        && !workflowActive
        && !string.IsNullOrWhiteSpace(botTarget)
        && selectedAccountIds.Count > 0
        && ParseScriptMessages(messageScript).Count > 0;

    private bool CanContinue => !running && HasNextStep;
    private bool CanStop => running || workflowActive;
    private bool CanReset => !running && (workflowActive || currentStepIndex >= 0 || history.Count > 0);
    private bool HasNextStep => workflowActive && currentStepIndex + 1 < workflowMessages.Count;

    private Severity StartHintSeverity => CanStart ? Severity.Success : Severity.Warning;

    private string StartHintText
    {
        get
        {
            if (running)
                return "正在执行中，请等待当前轮次完成。";
            if (workflowActive)
                return HasNextStep ? "当前轮已完成，可查看返回后点击“继续下一条”。" : "全部脚本已执行完成。";
            if (string.IsNullOrWhiteSpace(botTarget))
                return "请先填写机器人用户名或链接。";
            if (selectedAccountIds.Count == 0)
                return "请至少选择一个账号。";
            if (ParseScriptMessages(messageScript).Count == 0)
                return "请至少填写一条要发送的消息。";
            return $"已就绪：{selectedAccountIds.Count} 个账号，{ParseScriptMessages(messageScript).Count} 条脚本。";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAccountsAsync();
    }

    private async Task ReloadAccountsAsync()
    {
        loadingAccounts = true;
        try
        {
            accounts = (await AccountManagement.GetActiveAccountsAsync())
                .OrderBy(x => x.Id)
                .ToList();

            var validIds = accounts.Select(x => x.Id).ToHashSet();
            selectedAccountIds.RemoveWhere(id => !validIds.Contains(id));

            Snackbar.Add($"已加载 {accounts.Count} 个可用账号。", Severity.Info);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Load accounts failed");
            Snackbar.Add($"加载账号失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            loadingAccounts = false;
        }
    }

    private Task ToggleAccountSelectionAsync(int accountId)
    {
        if (selectedAccountIds.Contains(accountId))
            selectedAccountIds.Remove(accountId);
        else
            selectedAccountIds.Add(accountId);

        return Task.CompletedTask;
    }

    private Task SelectAllFiltered()
    {
        foreach (var account in FilteredAccounts)
            selectedAccountIds.Add(account.Id);

        Snackbar.Add($"已选择 {selectedAccountIds.Count} 个账号。", Severity.Success);
        return Task.CompletedTask;
    }

    private Task ClearSelection()
    {
        selectedAccountIds.Clear();
        Snackbar.Add("已清空账号选择。", Severity.Info);
        return Task.CompletedTask;
    }

    private async Task StartWorkflowAsync()
    {
        if (running)
            return;

        var messages = ParseScriptMessages(messageScript);
        if (messages.Count == 0)
        {
            Snackbar.Add("请至少填写一条脚本消息。", Severity.Warning);
            return;
        }

        if (selectedAccountIds.Count == 0)
        {
            Snackbar.Add("请先选择账号。", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(botTarget))
        {
            Snackbar.Add("请先填写机器人用户名或链接。", Severity.Warning);
            return;
        }

        workflowMessages.Clear();
        workflowMessages.AddRange(messages);
        currentStepResults.Clear();
        history.Clear();
        resolvedTargets.Clear();
        resolvedBotUsernames.Clear();
        currentStepIndex = -1;
        workflowActive = true;

        Snackbar.Add($"开始执行第 1 条，目标账号 {selectedAccountIds.Count} 个。", Severity.Info);
        await ExecuteNextStepAsync();
    }

    private async Task ContinueWorkflowAsync()
    {
        if (!HasNextStep || running)
            return;

        Snackbar.Add($"开始执行第 {currentStepIndex + 2} 条。", Severity.Info);
        await ExecuteNextStepAsync();
    }

    private Task StopWorkflow()
    {
        workflowActive = false;
        runCts?.Cancel();
        Snackbar.Add("流程已停止。", Severity.Warning);
        return Task.CompletedTask;
    }

    private Task ResetWorkflow()
    {
        if (running)
            return Task.CompletedTask;

        workflowActive = false;
        currentStepIndex = -1;
        workflowMessages.Clear();
        currentStepResults.Clear();
        history.Clear();
        resolvedTargets.Clear();
        resolvedBotUsernames.Clear();
        Snackbar.Add("流程已重置。", Severity.Info);
        return Task.CompletedTask;
    }

    private async Task ExecuteNextStepAsync()
    {
        if (!workflowActive)
            return;

        var stepIndex = currentStepIndex + 1;
        if (stepIndex < 0 || stepIndex >= workflowMessages.Count)
        {
            workflowActive = false;
            return;
        }

        await ExecuteStepAsync(stepIndex);
    }

    private async Task ExecuteStepAsync(int stepIndex)
    {
        var selectedAccounts = accounts
            .Where(x => selectedAccountIds.Contains(x.Id))
            .OrderBy(x => x.Id)
            .ToList();

        if (selectedAccounts.Count == 0)
        {
            workflowActive = false;
            Snackbar.Add("当前没有可执行的已选账号。", Severity.Warning);
            return;
        }

        var message = workflowMessages[stepIndex];
        var stepResults = new List<AccountStepResult>();
        var timeoutSeconds = Math.Clamp(waitTimeoutSeconds, 3, 300);
        var delaySeconds = Math.Clamp(delayBetweenAccountsSeconds, 0, 60);

        running = true;
        currentStepResults.Clear();
        runCts = new CancellationTokenSource();
        var cancellationToken = runCts.Token;
        StateHasChanged();

        try
        {
            for (var i = 0; i < selectedAccounts.Count; i++)
            {
                cancellationToken.ThrowIfCancellationRequested();
                var account = selectedAccounts[i];
                var row = new AccountStepResult
                {
                    AccountId = account.Id,
                    AccountLabel = BuildAccountLabel(account)
                };

                if (stepIndex == 0 && autoStartBeforeFirstMessage)
                {
                    var start = await AccountTelegramTools.StartExternalBotAsync(
                        account.Id,
                        botTarget,
                        startParameter,
                        cancellationToken,
                        assumeBotUsername: true);
                    if (!start.Success)
                    {
                        row.Error = start.Error ?? "发送 /start 失败。";
                        stepResults.Add(row);
                        currentStepResults.Clear();
                        currentStepResults.AddRange(stepResults.Select(x => x.Clone()));
                        StateHasChanged();
                        continue;
                    }
                }

                if (!resolvedTargets.TryGetValue(account.Id, out var target))
                {
                    var resolve = await AccountTelegramTools.ResolveExternalBotTargetAsync(
                        account.Id,
                        botTarget,
                        cancellationToken,
                        assumeBotUsername: true);
                    if (!resolve.Success || resolve.Target == null)
                    {
                        row.Error = resolve.Error ?? "解析机器人目标失败。";
                        stepResults.Add(row);
                        currentStepResults.Clear();
                        currentStepResults.AddRange(stepResults.Select(x => x.Clone()));
                        StateHasChanged();
                        continue;
                    }

                    target = resolve.Target;
                    resolvedTargets[account.Id] = target;
                    if (!string.IsNullOrWhiteSpace(resolve.BotUsername))
                        resolvedBotUsernames[account.Id] = resolve.BotUsername;
                }

                var send = await AccountTelegramTools.SendMessageToResolvedChatAsync(
                    account.Id,
                    target,
                    message,
                    replyToMessageId: null,
                    cancellationToken: cancellationToken);

                row.SendSuccess = send.Success;
                if (!send.Success || !send.MessageId.HasValue)
                {
                    row.Error = send.Error ?? "发送消息失败。";
                    stepResults.Add(row);
                    currentStepResults.Clear();
                    currentStepResults.AddRange(stepResults.Select(x => x.Clone()));
                    StateHasChanged();
                    continue;
                }

                var allowedSenders = BuildAllowedSenders(account.Id);
                var wait = await AccountTelegramTools.WaitForBotVerificationMessageAsync(
                    account.Id,
                    target,
                    send.MessageId.Value,
                    currentUsername: account.Username,
                    timeoutSeconds: timeoutSeconds,
                    messageFilter: static _ => true,
                    allowedSenderUsernames: allowedSenders,
                    restrictToAllowedUsernames: allowedSenders.Count > 0,
                    stopOnUnmatchedMention: false,
                    cancellationToken: cancellationToken);

                if (!wait.Success || wait.Candidate == null)
                {
                    row.Error = wait.Error ?? "未捕获到回复。";
                    stepResults.Add(row);
                    currentStepResults.Clear();
                    currentStepResults.AddRange(stepResults.Select(x => x.Clone()));
                    StateHasChanged();
                    continue;
                }

                row.ResponseSuccess = true;
                row.ResponseText = NormalizeResponseText(wait.Candidate);
                row.ButtonsSummary = BuildButtonsSummary(wait.Candidate);
                stepResults.Add(row);

                currentStepResults.Clear();
                currentStepResults.AddRange(stepResults.Select(x => x.Clone()));
                StateHasChanged();

                if (delaySeconds > 0 && i < selectedAccounts.Count - 1)
                    await Task.Delay(TimeSpan.FromSeconds(delaySeconds), cancellationToken);
            }

            currentStepIndex = stepIndex;
            currentStepResults.Clear();
            currentStepResults.AddRange(stepResults);
            history.Insert(0, new StepHistory
            {
                StepNumber = stepIndex + 1,
                Message = message,
                ExecutedAt = DateTimeOffset.Now,
                Results = stepResults.Select(x => x.Clone()).ToList()
            });

            if (currentStepIndex >= workflowMessages.Count - 1)
            {
                workflowActive = false;
                Snackbar.Add("全部脚本已执行完成。", Severity.Success);
            }
            else
            {
                Snackbar.Add($"第 {currentStepIndex + 1} 条执行完成。请查看回复后再决定是否继续。", Severity.Info);
            }
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("执行已取消。", Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Execute bot check-in step failed");
            Snackbar.Add($"执行失败：{ex.Message}", Severity.Error);
            workflowActive = false;
        }
        finally
        {
            running = false;
            runCts?.Dispose();
            runCts = null;
            StateHasChanged();
        }
    }

    private IReadOnlyCollection<string> BuildAllowedSenders(int accountId)
    {
        if (resolvedBotUsernames.TryGetValue(accountId, out var username) && !string.IsNullOrWhiteSpace(username))
            return new[] { username };

        return Array.Empty<string>();
    }

    private bool MatchesAccountSearch(Account account)
    {
        var keyword = (accountSearch ?? string.Empty).Trim();
        if (keyword.Length == 0)
            return true;

        return (account.DisplayPhone ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
               || (account.Username ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
               || (account.Nickname ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
               || (account.Remark ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase);
    }

    private static List<string> ParseScriptMessages(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return new List<string>();

        return raw
            .Replace("\r", "\n", StringComparison.Ordinal)
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();
    }

    private static string BuildAccountLabel(Account account)
    {
        var name = !string.IsNullOrWhiteSpace(account.Username)
            ? $"@{account.Username}"
            : (!string.IsNullOrWhiteSpace(account.Nickname) ? account.Nickname! : account.DisplayPhone);
        return $"#{account.Id} {name}";
    }

    private static string DisplayName(Account account)
    {
        if (!string.IsNullOrWhiteSpace(account.Nickname) && !string.IsNullOrWhiteSpace(account.Remark))
            return $"{account.Nickname} / {account.Remark}";
        if (!string.IsNullOrWhiteSpace(account.Nickname))
            return account.Nickname;
        if (!string.IsNullOrWhiteSpace(account.Remark))
            return account.Remark;
        return "-";
    }

    private static string NormalizeResponseText(TelegramVerificationMessageCandidate candidate)
    {
        if (!string.IsNullOrWhiteSpace(candidate.Text))
            return candidate.Text.Trim();
        if (candidate.ImageJpegBytes is { Length: > 0 })
            return "[图片]";
        return "[无文本]";
    }

    private static string? BuildButtonsSummary(TelegramVerificationMessageCandidate candidate)
    {
        if (candidate.Buttons.Count == 0)
            return null;

        return string.Join(" | ", candidate.Buttons.Select(x => Shorten(x.Text, 16)));
    }

    private static string ToSingleLine(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "-";
        return Shorten(text.Replace("\r", " ", StringComparison.Ordinal).Replace("\n", " ", StringComparison.Ordinal), maxLength);
    }

    private static string Shorten(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "-";
        var value = text.Trim();
        if (value.Length <= maxLength)
            return value;
        return value[..maxLength] + "...";
    }

    private sealed class AccountStepResult
    {
        public int AccountId { get; init; }
        public string AccountLabel { get; init; } = string.Empty;
        public bool SendSuccess { get; set; }
        public bool ResponseSuccess { get; set; }
        public string? ResponseText { get; set; }
        public string? ButtonsSummary { get; set; }
        public string? Error { get; set; }

        public AccountStepResult Clone()
        {
            return new AccountStepResult
            {
                AccountId = AccountId,
                AccountLabel = AccountLabel,
                SendSuccess = SendSuccess,
                ResponseSuccess = ResponseSuccess,
                ResponseText = ResponseText,
                ButtonsSummary = ButtonsSummary,
                Error = Error
            };
        }
    }

    private sealed class StepHistory
    {
        public int StepNumber { get; init; }
        public string Message { get; init; } = string.Empty;
        public DateTimeOffset ExecutedAt { get; init; }
        public List<AccountStepResult> Results { get; init; } = new();
    }
}
